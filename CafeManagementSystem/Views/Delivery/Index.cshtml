@model List<CafeManagementSystem.Models.Entities.Order>
@{
    ViewData["Title"] = "Điều Phối Giao Hàng & Thu COD";
}

<div class="container-fluid py-3 px-3 px-lg-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 pb-2 border-bottom" style="border-color: var(--border-color) !important;">
        <div>
            <h2 class="fw-bold text-dark mb-1">Giao hàng & Thu COD</h2>
            <p class="text-muted small mb-0">Quản lý nhận đơn vận chuyển, tiến trình giao và bàn giao tiền COD vào ca thu ngân</p>
        </div>
        <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: var(--primary-green-light); color: var(--primary-green);">
            <i class="bi bi-bicycle me-1"></i> Nhân viên Giao hàng (Shipper)
        </span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5" 
             style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
            <div class="card-body py-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                     style="width: 72px; height: 72px; background-color: var(--primary-green-light); color: var(--primary-green);">
                    <i class="bi bi-bicycle fs-2"></i>
                </div>
                <h4 class="fw-bold text-dark">Hiện không có đơn hàng online cần giao</h4>
                <p class="text-muted small mb-0">Các đơn hàng mới sẽ xuất hiện ngay khi quầy bar hoàn tất pha chế.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var order in Model)
            {
                var delivery = order.Delivery;
                var codAmount = delivery?.CodAmount ?? Math.Max(0m, order.TotalAmount - order.PaymentTransactions
                    .Where(payment => payment.PaymentStatus == "Success")
                    .Sum(payment => payment.Amount));
                var status = delivery?.DeliveryStatus ?? "Ready";
                
                string statusText = status switch
                {
                    "Assigned" => "Đã nhận đơn",
                    "PickedUp" => "Đã lấy nước tại quầy",
                    "Delivering" => "Đang giao trên đường",
                    "Delivered" => "Đã giao thành công",
                    "Failed" => "Giao thất bại",
                    _ => "Chờ Shipper nhận đơn"
                };

                string badgeClass = status switch
                {
                    "Assigned" => "cafe-badge-warning",
                    "PickedUp" => "cafe-badge-warning",
                    "Delivering" => "cafe-badge-warning",
                    "Delivered" => "cafe-badge-success",
                    "Failed" => "cafe-badge-danger",
                    _ => "cafe-badge-neutral"
                };

                <div class="col-12 col-xl-6">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100" 
                         style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                        
                        <!-- Header -->
                        <div class="p-3 d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom"
                             style="background-color: #FAF7F2; border-color: var(--border-color) !important;">
                            <div>
                                <span class="fw-bold fs-6" style="color: var(--primary-green);">#@order.OrderCode</span>
                                <span class="text-muted small ms-2" style="font-size: 0.8rem;">
                                    <i class="bi bi-clock me-1"></i>@order.CreatedAt.ToString("dd/MM HH:mm")
                                </span>
                            </div>
                            <span class="cafe-badge @badgeClass">@statusText</span>
                        </div>

                        <div class="card-body p-3">
                            <div class="row g-3">
                                <!-- Order Items -->
                                <div class="col-12 col-md-6 border-end-md" style="border-color: var(--border-light) !important;">
                                    <h6 class="fw-bold text-dark small text-uppercase mb-2" style="letter-spacing: 0.5px;">
                                        <i class="bi bi-cup-straw me-1" style="color: var(--accent-caramel);"></i>Món trong đơn
                                    </h6>
                                    @if (order.OrderItems.Count == 0)
                                    {
                                        <p class="text-muted small mb-0">Không có chi tiết đồ uống.</p>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var item in order.OrderItems)
                                            {
                                                <div class="small text-muted d-flex justify-content-between">
                                                    <div>
                                                        <strong class="text-dark">@(item.Variant?.Product?.ProductName ?? "Đồ uống")</strong>
                                                        <span>(Size @(item.Variant?.SizeName ?? "-"))</span>
                                                    </div>
                                                    <span class="badge rounded-pill bg-light text-dark border">x@item.Quantity</span>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- Recipient Details -->
                                    <div class="p-2 rounded-3 mt-3" style="background-color: #FAF7F2; border: 1px dashed var(--border-color); font-size: 0.82rem;">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Người nhận:</span>
                                            <strong class="text-dark">@(delivery?.RecipientName ?? order.Customer?.FullName ?? "Chưa rõ")</strong>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Điện thoại:</span>
                                            <a href="tel:@(delivery?.RecipientPhone ?? order.Customer?.Phone)" class="fw-bold text-decoration-none" style="color: var(--primary-green);">
                                                <i class="bi bi-telephone-fill me-1"></i>@(delivery?.RecipientPhone ?? order.Customer?.Phone ?? "-")
                                            </a>
                                        </div>
                                        <div class="mb-1">
                                            <span class="text-muted d-block">Địa chỉ:</span>
                                            <span class="text-dark fw-semibold">@(delivery?.ShippingAddress ?? order.Customer?.Address ?? "-")</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center pt-1 border-top" style="border-color: var(--border-light) !important;">
                                            <span class="text-muted">Tiền COD thu:</span>
                                            <strong class="fs-6" style="color: var(--primary-green);">@codAmount.ToString("N0") đ</strong>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Form per status -->
                                <div class="col-12 col-md-6 d-flex flex-column justify-content-between">
                                    <div>
                                        <h6 class="fw-bold text-dark small text-uppercase mb-2" style="letter-spacing: 0.5px;">
                                            <i class="bi bi-geo-alt me-1" style="color: var(--primary-green);"></i>Thao tác tiến trình
                                        </h6>

                                        @if (delivery == null)
                                        {
                                            <form asp-action="AcceptOrder" method="post">
                                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                                <div class="mb-2">
                                                    <label class="form-label small mb-1 fw-bold text-dark" for="recipientName_@order.OrderId">Tên người nhận</label>
                                                    <input class="form-control form-control-sm" id="recipientName_@order.OrderId" name="recipientName" value="@order.Customer?.FullName" maxlength="100" required />
                                                </div>
                                                <div class="mb-2">
                                                    <label class="form-label small mb-1 fw-bold text-dark" for="recipientPhone_@order.OrderId">Số điện thoại</label>
                                                    <input class="form-control form-control-sm" id="recipientPhone_@order.OrderId" name="recipientPhone" value="@order.Customer?.Phone" maxlength="20" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small mb-1 fw-bold text-dark" for="shippingAddress_@order.OrderId">Địa chỉ giao</label>
                                                    <textarea class="form-control form-control-sm" id="shippingAddress_@order.OrderId" name="shippingAddress" maxlength="300" rows="2" required>@order.Customer?.Address</textarea>
                                                </div>
                                                <button type="submit" class="btn btn-cafe-primary btn-sm w-100 rounded-pill fw-bold py-2">
                                                    <i class="bi bi-bicycle me-1"></i> Nhận đơn giao này
                                                </button>
                                            </form>
                                        }
                                        else if (delivery.DeliveryStatus == "Assigned")
                                        {
                                            <div class="alert alert-warning py-2 mb-3 small">
                                                <i class="bi bi-hourglass-split me-1"></i> Quầy bar đang pha chế. Hãy đến quầy lấy đồ uống.
                                            </div>
                                            <form asp-action="UpdateDeliveryStatus" method="post">
                                                <input type="hidden" name="deliveryId" value="@delivery.DeliveryId" />
                                                <input type="hidden" name="newStatus" value="PickedUp" />
                                                <button type="submit" class="btn btn-cafe-primary btn-sm w-100 rounded-pill fw-bold py-2">
                                                    <i class="bi bi-box-seam me-1"></i> Đã nhận nước tại quầy
                                                </button>
                                            </form>
                                        }
                                        else if (delivery.DeliveryStatus == "PickedUp")
                                        {
                                            <div class="alert alert-info py-2 mb-3 small">
                                                <i class="bi bi-truck me-1"></i> Đã lấy đồ uống. Bắt đầu di chuyển giao cho khách.
                                            </div>
                                            <form asp-action="UpdateDeliveryStatus" method="post">
                                                <input type="hidden" name="deliveryId" value="@delivery.DeliveryId" />
                                                <input type="hidden" name="newStatus" value="Delivering" />
                                                <button type="submit" class="btn btn-cafe-caramel btn-sm w-100 rounded-pill fw-bold py-2">
                                                    <i class="bi bi-bicycle me-1"></i> Bắt đầu giao trên đường
                                                </button>
                                            </form>
                                        }
                                        else if (delivery.DeliveryStatus == "Delivering")
                                        {
                                            <form asp-action="UpdateDeliveryStatus" method="post" class="mb-3">
                                                <input type="hidden" name="deliveryId" value="@delivery.DeliveryId" />
                                                <input type="hidden" name="newStatus" value="Delivered" />
                                                @if (delivery.CodAmount > 0)
                                                {
                                                    <div class="form-check p-2 rounded border mb-2" style="background-color: #FAF7F2;">
                                                        <input class="form-check-input ms-0 me-2" type="checkbox" id="codCollected_@delivery.DeliveryId" name="isCodCollected" value="true" required />
                                                        <label class="form-check-label small fw-bold text-dark" for="codCollected_@delivery.DeliveryId">
                                                            Đã thu đủ <strong>@delivery.CodAmount.ToString("N0") đ</strong> tiền mặt COD
                                                        </label>
                                                    </div>
                                                }
                                                <button type="submit" class="btn btn-cafe-primary btn-sm w-100 rounded-pill fw-bold py-2 mb-2">
                                                    <i class="bi bi-check2-circle me-1"></i> Giao hàng thành công
                                                </button>
                                            </form>

                                            <form asp-action="UpdateDeliveryStatus" method="post">
                                                <input type="hidden" name="deliveryId" value="@delivery.DeliveryId" />
                                                <input type="hidden" name="newStatus" value="Failed" />
                                                <input type="text" class="form-control form-control-sm mb-2" id="problemNote_@delivery.DeliveryId" name="problemNote" placeholder="Lý do không giao được (khách không nghe máy...)" required />
                                                <button type="submit" class="btn btn-cafe-outline btn-sm w-100 rounded-pill text-danger">
                                                    <i class="bi bi-x-circle me-1"></i> Báo giao thất bại
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="p-3 rounded-3 text-center small text-muted" style="background-color: #FAF7F2;">
                                                <i class="bi bi-check-circle-fill text-success fs-5 d-block mb-1"></i>
                                                Đơn hàng đã hoàn tất tiến trình giao hàng.
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
