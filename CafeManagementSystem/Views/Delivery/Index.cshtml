@model List<CafeManagementSystem.Models.Entities.Order>
@{
    ViewData["Title"] = "Giao Hàng & Thu COD";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-bicycle text-info me-2"></i>Quản Lý Giao Hàng & Thu Tiền COD (Shipper)</h3>
            <p class="text-muted mb-0">Cập nhật tiến độ giao đồ uống và nộp tiền COD về ca thu ngân</p>
        </div>
        <span class="badge bg-info text-dark fs-6 px-3 py-2">
            <i class="bi bi-truck me-1"></i> Delivery Staff
        </span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info p-4 text-center rounded-3 shadow-sm">
            <i class="bi bi-info-circle-fill fs-2 d-block mb-2 text-info"></i>
            <h5>Hiện không có đơn hàng online cần giao.</h5>
            <p class="text-muted mb-0">Đơn hàng sẽ hiển thị khi pha chế hoàn tất hoặc đang được giao.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var order in Model)
            {
                var delivery = order.Delivery;
                var codAmount = delivery?.CodAmount ?? Math.Max(0m, order.TotalAmount - order.PaymentTransactions
                    .Where(payment => payment.PaymentStatus == "Success")
                    .Sum(payment => payment.Amount));
                var status = delivery?.DeliveryStatus ?? "Ready";
                var statusClass = status switch
                {
                    "Assigned" => "bg-primary",
                    "PickedUp" => "bg-info text-dark",
                    "Delivering" => "bg-warning text-dark",
                    "Delivered" => "bg-success",
                    "Failed" => "bg-danger",
                    _ => "bg-secondary"
                };

                <div class="col-12">
                    <section class="card shadow-sm border-0">
                        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <span class="fw-bold text-primary fs-5">#@order.OrderCode</span>
                                <span class="text-muted ms-2">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <span class="badge @statusClass">@(delivery?.DeliveryStatus ?? "Chờ Shipper nhận")</span>
                        </div>
                        <div class="card-body">
                            <div class="row g-4">
                                <div class="col-lg-5">
                                    <h6 class="fw-bold">Đồ uống trong đơn</h6>
                                    @if (order.OrderItems.Count == 0)
                                    {
                                        <p class="text-muted mb-0">Không có chi tiết đồ uống.</p>
                                    }
                                    else
                                    {
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var item in order.OrderItems)
                                            {
                                                <li class="mb-1">
                                                    <span class="fw-semibold">@(item.Variant?.Product?.ProductName ?? "Đồ uống")</span>
                                                    <span class="text-muted">(@(item.Variant?.SizeName ?? "Không rõ size")) × @item.Quantity</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.SugarLevel) || !string.IsNullOrWhiteSpace(item.IceLevel))
                                                    {
                                                        <small class="d-block text-muted">Đường: @(item.SugarLevel ?? "-") · Đá: @(item.IceLevel ?? "-")</small>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                                <div class="col-lg-4">
                                    <h6 class="fw-bold">Thông tin giao hàng</h6>
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4">Người nhận</dt>
                                        <dd class="col-sm-8">@(delivery?.RecipientName ?? order.Customer?.FullName ?? "Chưa có thông tin")</dd>
                                        <dt class="col-sm-4">Điện thoại</dt>
                                        <dd class="col-sm-8">@(delivery?.RecipientPhone ?? order.Customer?.Phone ?? "Chưa có thông tin")</dd>
                                        <dt class="col-sm-4">Địa chỉ</dt>
                                        <dd class="col-sm-8">@(delivery?.ShippingAddress ?? order.Customer?.Address ?? "Chưa có thông tin")</dd>
                                        <dt class="col-sm-4">COD</dt>
                                        <dd class="col-sm-8 fw-bold">@codAmount.ToString("N0") đ</dd>
                                        @if (delivery != null)
                                        {
                                            <dt class="col-sm-4">Thu COD</dt>
                                            <dd class="col-sm-8">
                                                @if (delivery.IsCodCollected)
                                                {
                                                    <span class="badge bg-success">Đã thu</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Chưa thu</span>
                                                }
                                            </dd>
                                        }
                                    </dl>
                                    @if (delivery?.DeliveryStatus == "Failed" && !string.IsNullOrWhiteSpace(delivery.ProblemNote))
                                    {
                                        <div class="alert alert-danger py-2 mt-2 mb-0">
                                            <strong>Sự cố:</strong> @delivery.ProblemNote
                                        </div>
                                    }
                                </div>
                                <div class="col-lg-3">
                                    @if (delivery == null)
                                    {
                                        <h6 class="fw-bold">Nhận đơn giao</h6>
                                        <form asp-action="AcceptOrder" method="post">
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <div class="mb-2">
                                                <label class="form-label small mb-1" for="recipientName_@order.OrderId">Tên người nhận</label>
                                                <input class="form-control form-control-sm" id="recipientName_@order.OrderId" name="recipientName" value="@order.Customer?.FullName" maxlength="100" required />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label small mb-1" for="recipientPhone_@order.OrderId">Số điện thoại</label>
                                                <input class="form-control form-control-sm" id="recipientPhone_@order.OrderId" name="recipientPhone" value="@order.Customer?.Phone" maxlength="20" required />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label small mb-1" for="shippingAddress_@order.OrderId">Địa chỉ giao</label>
                                                <textarea class="form-control form-control-sm" id="shippingAddress_@order.OrderId" name="shippingAddress" maxlength="300" rows="2" required>@order.Customer?.Address</textarea>
                                            </div>
                                            <button type="submit" class="btn btn-info btn-sm w-100">
                                                <i class="bi bi-bicycle me-1"></i> Nhận đơn
                                            </button>
                                        </form>
                                    }
                                    else if (delivery.DeliveryStatus == "Assigned")
                                    {
                                        <h6 class="fw-bold">Cập nhật tiến trình</h6>
                                        <form asp-action="UpdateDeliveryStatus" method="post">
                                            <input type="hidden" name="deliveryId" value="@delivery.DeliveryId" />
                                            <input type="hidden" name="newStatus" value="PickedUp" />
                                            <button type="submit" class="btn btn-primary btn-sm w-100">Đã lấy nước tại quầy</button>
                                        </form>
                                    }
                                    else if (delivery.DeliveryStatus == "PickedUp")
                                    {
                                        <h6 class="fw-bold">Cập nhật tiến trình</h6>
                                        <form asp-action="UpdateDeliveryStatus" method="post">
                                            <input type="hidden" name="deliveryId" value="@delivery.DeliveryId" />
                                            <input type="hidden" name="newStatus" value="Delivering" />
                                            <button type="submit" class="btn btn-warning btn-sm w-100">Đang giao trên đường</button>
                                        </form>
                                    }
                                    else if (delivery.DeliveryStatus == "Delivering")
                                    {
                                        <h6 class="fw-bold">Kết quả giao hàng</h6>
                                        <form asp-action="UpdateDeliveryStatus" method="post" class="mb-3">
                                            <input type="hidden" name="deliveryId" value="@delivery.DeliveryId" />
                                            <input type="hidden" name="newStatus" value="Delivered" />
                                            @if (delivery.CodAmount > 0)
                                            {
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="checkbox" id="codCollected_@delivery.DeliveryId" name="isCodCollected" value="true" required />
                                                    <label class="form-check-label small" for="codCollected_@delivery.DeliveryId">Đã thu @delivery.CodAmount.ToString("N0") đ tiền mặt</label>
                                                </div>
                                            }
                                            <button type="submit" class="btn btn-success btn-sm w-100">Giao thành công</button>
                                        </form>
                                        <form asp-action="UpdateDeliveryStatus" method="post">
                                            <input type="hidden" name="deliveryId" value="@delivery.DeliveryId" />
                                            <input type="hidden" name="newStatus" value="Failed" />
                                            <label class="form-label small mb-1" for="problemNote_@delivery.DeliveryId">Mô tả sự cố</label>
                                            <textarea class="form-control form-control-sm mb-2" id="problemNote_@delivery.DeliveryId" name="problemNote" maxlength="500" rows="2" required></textarea>
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Giao thất bại</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <p class="text-muted small mb-0">Đơn hàng đã ghi nhận kết quả giao.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            }
        </div>
    }
</div>
