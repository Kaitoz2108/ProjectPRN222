<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Laura Café Management System - Thưởng thức cà phê, theo cách của bạn")</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/images/cafe-logo.svg" />
    <link rel="shortcut icon" href="~/favicon.ico" />

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Google Fonts: Lora (Serif) & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Isolated Landing Page CSS -->
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body class="cafe-landing-body">
    <div class="cafe-landing">
        <!-- Header (Navbar) -->
        <header class="landing-header">
            <div class="cafe-landing-container">
                <div class="d-flex align-items-center justify-content-between">
                    <!-- Brand Logo -->
                    <a class="landing-brand" asp-controller="Landing" asp-action="Index">
                        <svg class="landing-brand-icon" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M2.08 14.88C1.52 11.23 2.74 7.42 5.56 4.6C8.38 1.78 12.19 0.56 15.84 1.12C16.89 1.28 17.84 1.84 18.5 2.68C19.86 4.41 19.34 6.89 17.65 8.58C16.48 9.75 14.85 10.45 13.15 10.74C10.66 11.17 8.35 12.35 6.64 14.06C5.46 15.24 3.79 16.03 2.08 14.88ZM21.92 9.12C22.48 12.77 21.26 16.58 18.44 19.4C15.62 22.22 11.81 23.44 8.16 22.88C7.11 22.72 6.16 22.16 5.5 21.32C4.14 19.59 4.66 17.11 6.35 15.42C7.52 14.25 9.15 13.55 10.85 13.26C13.34 12.83 15.65 11.65 17.36 9.94C18.54 8.76 20.21 7.97 21.92 9.12Z"/>
                        </svg>
                        <div class="d-flex flex-column" style="line-height: 1.15;">
                            <span class="fw-bold" style="font-size: 1.25rem; letter-spacing: -0.3px;">Laura Café</span>
                            <span style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.8px; opacity: 0.8; font-weight: 600; color: var(--landing-accent-caramel);">Management System</span>
                        </div>
                    </a>

                    <!-- Navigation Center (Desktop) -->
                    <nav class="d-none d-md-block">
                        <ul class="landing-nav-links">
                            <li><a href="#" class="landing-nav-link active">Trang chủ</a></li>
                            <li><a asp-controller="Customer" asp-action="Menu" class="landing-nav-link">Thực đơn</a></li>
                            <li><a href="#about" class="landing-nav-link">Về chúng tôi</a></li>
                            <li><a href="#contact" class="landing-nav-link">Liên hệ</a></li>
                        </ul>
                    </nav>

                    <!-- Right Actions: Login & CTA (Desktop) -->
                    <div class="landing-header-actions d-none d-md-flex">
                        <a asp-controller="Account" asp-action="Login" class="landing-login-link">Đăng nhập</a>
                        <a asp-controller="Customer" asp-action="Menu" class="landing-btn-primary">Đặt món ngay</a>
                    </div>

                    <!-- Mobile Burger Toggle Button -->
                    <button class="landing-mobile-toggle d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#landingMobileNav" aria-controls="landingMobileNav" aria-label="Mở Menu">
                        <i class="bi bi-list fs-2"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Mobile Offcanvas Menu -->
        <div class="offcanvas offcanvas-end" tabindex="-1" id="landingMobileNav" aria-labelledby="landingMobileNavLabel" style="background-color: var(--landing-bg);">
            <div class="offcanvas-header border-bottom">
                <a class="landing-brand fs-4" asp-controller="Landing" asp-action="Index">
                    <svg class="landing-brand-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M2.08 14.88C1.52 11.23 2.74 7.42 5.56 4.6C8.38 1.78 12.19 0.56 15.84 1.12C16.89 1.28 17.84 1.84 18.5 2.68C19.86 4.41 19.34 6.89 17.65 8.58C16.48 9.75 14.85 10.45 13.15 10.74C10.66 11.17 8.35 12.35 6.64 14.06C5.46 15.24 3.79 16.03 2.08 14.88ZM21.92 9.12C22.48 12.77 21.26 16.58 18.44 19.4C15.62 22.22 11.81 23.44 8.16 22.88C7.11 22.72 6.16 22.16 5.5 21.32C4.14 19.59 4.66 17.11 6.35 15.42C7.52 14.25 9.15 13.55 10.85 13.26C13.34 12.83 15.65 11.65 17.36 9.94C18.54 8.76 20.21 7.97 21.92 9.12Z"/>
                    </svg>
                    <div class="d-flex flex-column" style="line-height: 1.15;">
                        <span class="fw-bold" style="font-size: 1.2rem; letter-spacing: -0.3px;">Laura Café</span>
                        <span style="font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.8px; opacity: 0.8; font-weight: 600; color: var(--landing-accent-caramel);">Management System</span>
                    </div>
                </a>
                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column justify-content-between p-4">
                <div class="d-flex flex-column gap-3">
                    <a href="#" class="fs-5 fw-bold text-decoration-none text-dark py-2 border-bottom">Trang chủ</a>
                    <a asp-controller="Customer" asp-action="Menu" class="fs-5 fw-semibold text-decoration-none text-dark py-2 border-bottom">Thực đơn</a>
                    <a href="#about" class="fs-5 fw-semibold text-decoration-none text-dark py-2 border-bottom">Về chúng tôi</a>
                    <a href="#contact" class="fs-5 fw-semibold text-decoration-none text-dark py-2 border-bottom">Liên hệ</a>
                </div>
                <div class="d-flex flex-column gap-3 pt-4 border-top">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark rounded-pill py-2 fw-semibold">Đăng nhập</a>
                    <a asp-controller="Customer" asp-action="Menu" class="landing-btn-primary justify-content-center py-2">Đặt món ngay</a>
                </div>
            </div>
        </div>

        <!-- Main Body Content -->
        <main>
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="landing-footer" id="contact">
            <div class="cafe-landing-container">
                <div class="landing-footer-top">
                    <!-- Brand -->
                    <a class="landing-brand" asp-controller="Landing" asp-action="Index">
                        <svg class="landing-brand-icon" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M2.08 14.88C1.52 11.23 2.74 7.42 5.56 4.6C8.38 1.78 12.19 0.56 15.84 1.12C16.89 1.28 17.84 1.84 18.5 2.68C19.86 4.41 19.34 6.89 17.65 8.58C16.48 9.75 14.85 10.45 13.15 10.74C10.66 11.17 8.35 12.35 6.64 14.06C5.46 15.24 3.79 16.03 2.08 14.88ZM21.92 9.12C22.48 12.77 21.26 16.58 18.44 19.4C15.62 22.22 11.81 23.44 8.16 22.88C7.11 22.72 6.16 22.16 5.5 21.32C4.14 19.59 4.66 17.11 6.35 15.42C7.52 14.25 9.15 13.55 10.85 13.26C13.34 12.83 15.65 11.65 17.36 9.94C18.54 8.76 20.21 7.97 21.92 9.12Z"/>
                        </svg>
                        <div class="d-flex flex-column" style="line-height: 1.15;">
                            <span class="fw-bold" style="font-size: 1.25rem; letter-spacing: -0.3px;">Laura Café</span>
                            <span style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.8px; opacity: 0.8; font-weight: 600; color: var(--landing-accent-caramel);">Management System</span>
                        </div>
                    </a>

                    <!-- Footer Links -->
                    <ul class="landing-footer-links">
                        <li><a asp-controller="Customer" asp-action="Menu" class="landing-footer-link">Thực đơn</a></li>
                        <li><a href="#about" class="landing-footer-link">Về chúng tôi</a></li>
                        <li><a href="#contact" class="landing-footer-link">Liên hệ</a></li>
                    </ul>
                </div>

                <div class="landing-footer-bottom">
                    &copy; @DateTime.Now.Year Laura Café Management System
                </div>
            </div>
        </footer>
    </div>

    <!-- Bootstrap 5 JS Bundle & Isolated Landing Script -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/landing.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

