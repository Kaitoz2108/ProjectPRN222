@model ErrorViewModel
@{
    ViewData["Title"] = "Đã Xảy Ra Lỗi";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-5" 
             style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
            
            <div class="mb-3" style="color: var(--status-danger);">
                <i class="bi bi-exclamation-triangle fs-1" style="font-size: 3.5rem !important;"></i>
            </div>
            
            <h3 class="fw-bold text-dark mb-2">Đã Xảy Ra Lỗi Xử Lý</h3>
            <p class="text-muted small mb-4">
                Hệ thống gặp sự cố không mong muốn trong khi thực hiện yêu cầu của bạn. Đội ngũ kỹ thuật đã được thông báo để kiểm tra và xử lý.
            </p>

            @if (Model != null && Model.ShowRequestId)
            {
                <div class="p-2 rounded-3 mb-4 font-monospace small" style="background-color: #FAF7F2; border: 1px dashed var(--border-color);">
                    <span class="text-muted">Mã yêu cầu (Request ID):</span> <strong>@Model.RequestId</strong>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a href="javascript:history.back()" class="btn btn-cafe-outline rounded-pill px-4 fw-bold">
                    <i class="bi bi-arrow-left me-1"></i> Quay Lại
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-cafe-primary rounded-pill px-4 fw-bold">
                    <i class="bi bi-house me-1"></i> Về Trang Chủ
                </a>
            </div>
        </div>
    </div>
</div>
