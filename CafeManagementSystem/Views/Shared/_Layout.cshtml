@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Café Management System (CMS)</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CafeManagementSystem.styles.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #334155;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        main {
            flex: 1;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .nav-link {
            font-weight: 500;
            padding: 0.5rem 0.85rem !important;
            border-radius: 6px;
            transition: all 0.2s ease-in-out;
        }
        .nav-link:hover, .nav-link.active {
            background-color: rgba(255, 255, 255, 0.15);
        }
        .card {
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand text-warning d-flex align-items-center" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-cup-hot-fill fs-4 me-2"></i>
                    <span>CAFÉ CMS</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @* 1. MENU CHO ROLE ADMIN *@
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-1 text-danger"></i> Bảng Điều Khiển
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white-50" asp-controller="Cashier" asp-action="Shift">
                                        <i class="bi bi-cash-stack me-1"></i> Giám Sát Ca
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white-50" asp-controller="Cashier" asp-action="POS">
                                        <i class="bi bi-cart3 me-1"></i> Bán Hàng POS
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white-50" asp-controller="Barista" asp-action="KDS">
                                        <i class="bi bi-cup-hot me-1"></i> Bếp Pha Chế (KDS)
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white-50" asp-controller="Barista" asp-action="Wastage">
                                        <i class="bi bi-box-seam me-1"></i> Kho Quầy Bar & Báo Hao Hụt
                                    </a>
                                </li>
                            }

                            @* 2. MENU CHO ROLE CASHIER *@
                            @if (User.IsInRole("Cashier"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Cashier" asp-action="POS">
                                        <i class="bi bi-calculator me-1 text-primary"></i> Bán Hàng Tại Quầy (POS)
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Cashier" asp-action="Shift">
                                        <i class="bi bi-clock-history me-1 text-warning"></i> Quản Lý Ca & Bàn Giao
                                    </a>
                                </li>
                            }

                            @* 3. MENU CHO ROLE BARISTA *@
                            @if (User.IsInRole("Barista"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Barista" asp-action="KDS">
                                        <i class="bi bi-cup-hot-fill me-1 text-warning"></i> Màn Hình Pha Chế (KDS)
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white-50" asp-controller="Barista" asp-action="Wastage">
                                        <i class="bi bi-box-seam me-1"></i> Kho Quầy Bar & Báo Hao Hụt
                                    </a>
                                </li>
                            }

                            @* 4. MENU CHO ROLE DELIVERYSTAFF *@
                            @if (User.IsInRole("DeliveryStaff"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Delivery" asp-action="Index">
                                        <i class="bi bi-bicycle me-1 text-info"></i> Đơn Giao & Thu COD
                                    </a>
                                </li>
                            }

                            @* 5. MENU CHO ROLE CUSTOMER *@
                            @if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Customer" asp-action="Menu">
                                        <i class="bi bi-cup-straw me-1 text-success"></i> Thực Đơn Đồ Uống
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-house me-1"></i> Trang Chủ
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Khu vực người dùng bên phải -->
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var roleName = User.FindFirstValue(ClaimTypes.Role) ?? "";
                            string roleBadgeClass = roleName switch
                            {
                                "Admin" => "bg-danger",
                                "Cashier" => "bg-primary",
                                "Barista" => "bg-warning text-dark",
                                "DeliveryStaff" => "bg-info text-dark",
                                _ => "bg-success"
                            };

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <span>@User.Identity.Name</span>
                                    <span class="badge @roleBadgeClass ms-1">@roleName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userMenu">
                                    <li>
                                        <div class="px-3 py-1">
                                            <small class="text-muted d-block">Vai trò hiện tại</small>
                                            <strong>@roleName</strong>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person me-2"></i> Hồ sơ cá nhân
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-warning text-dark fw-semibold" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Đăng Ký Khách
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Flash Messages (TempData) -->
    <div class="container-fluid px-lg-4 mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> @TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Body Content -->
    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-3 text-muted text-center small mt-auto">
        <div class="container-fluid">
            <span>&copy; 2026 Café Management System (CMS) - Nhóm 5 người - PRN222</span>
            <span class="mx-2">|</span>
            <span>ASP.NET Core 8.0 MVC Thuần</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
