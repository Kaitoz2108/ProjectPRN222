@model CafeManagementSystem.Models.ViewModels.CashierShiftViewModel
@{
    ViewData["Title"] = "Quản Lý Ca Thu Ngân & Đối Soát Tiền Mặt";
}

<div class="container-fluid py-3 px-3 px-lg-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom" style="border-color: var(--border-color) !important;">
        <div>
            <h2 class="fw-bold text-dark mb-1">Quản lý ca & Đối soát tiền mặt</h2>
            <p class="text-muted small mb-0">Theo dõi dòng tiền bán hàng, tiền COD nhận từ shipper và đối soát chênh lệch két</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (Model.HasOpenShift)
            {
                <span class="cafe-badge cafe-badge-success">
                    <i class="bi bi-record-circle-fill"></i> Ca đang mở (#@Model.CurrentShift!.ShiftId)
                </span>
                <a asp-action="POS" class="btn btn-cafe-primary rounded-pill px-4 fw-semibold">
                    <i class="bi bi-cart3 me-1"></i> Bán hàng tại POS
                </a>
            }
            else
            {
                <span class="cafe-badge cafe-badge-neutral">
                    <i class="bi bi-door-closed me-1"></i> Chưa có ca mở
                </span>
            }
        </div>
    </div>

    @if (!Model.HasOpenShift)
    {
        <!-- ======================================================== -->
        <!-- TRƯỜNG HỢP 1: CASHIER CHƯA CÓ CA OPEN -> MỞ CA MỚI -->
        <!-- ======================================================== -->
        <div class="row g-4 justify-content-center">
            <!-- Thông tin ca đóng gần nhất (Previous Shift) -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100" 
                     style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                    <div class="card-header border-bottom p-3" style="background-color: #FAF7F2; border-color: var(--border-color) !important;">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-clock-history me-2" style="color: var(--accent-caramel);"></i>Ca Trước Bàn Giao Lại
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        @if (Model.PreviousShift != null)
                        {
                            <div class="mb-3">
                                <span class="text-muted d-block small" style="font-size: 0.75rem;">MÃ CA TRƯỚC</span>
                                <span class="fw-bold fs-5 text-dark">#@Model.PreviousShift.ShiftId</span>
                            </div>
                            <div class="mb-3">
                                <span class="text-muted d-block small" style="font-size: 0.75rem;">THỜI GIAN ĐÓNG CA</span>
                                <span class="fw-semibold text-dark">
                                    @(Model.PreviousShift.EndTime?.ToString("dd/MM/yyyy HH:mm:ss") ?? "Chưa ghi nhận")
                                </span>
                            </div>
                            <div class="mb-3 p-3 rounded-3" style="background-color: var(--primary-green-light); border: 1px solid rgba(53,87,70,0.2);">
                                <span class="fw-bold d-block small" style="color: var(--primary-green); font-size: 0.75rem;">TIỀN MẶT BÀN GIAO TRONG KÉT</span>
                                <span class="fs-3 fw-bold" style="color: var(--primary-green);">
                                    @((Model.PreviousShift.ClosingActualCash ?? 0).ToString("N0")) đ
                                </span>
                            </div>
                            <div class="mb-3">
                                <span class="text-muted d-block small" style="font-size: 0.75rem;">GHI CHÚ BÀN GIAO</span>
                                <div class="p-2 rounded border small text-muted fst-italic" style="background-color: #FAF7F2; border-color: var(--border-subtle) !important;">
                                    @(string.IsNullOrWhiteSpace(Model.PreviousShift.HandoverNotes) ? "Không có ghi chú thêm." : Model.PreviousShift.HandoverNotes)
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 rounded-3 small text-muted" style="background-color: #F8F5EE; border: 1px solid var(--border-color);">
                                <i class="bi bi-info-circle me-1"></i> Chưa có dữ liệu ca làm việc trước đó. Bạn có thể nhập số tiền mặt đầu ngày để khởi tạo ca đầu tiên.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Form mở ca mới (OpenShift Form) -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100" 
                     style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                    <div class="card-header border-bottom p-3" style="background-color: var(--sidebar-bg); border-color: var(--border-color) !important;">
                        <h5 class="fw-bold text-white mb-0">
                            <i class="bi bi-key-fill me-2" style="color: #FFE082;"></i>Xác Nhận Tiền Mặt Đầu Ca & Mở Ca
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="OpenShift" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="InputOpeningCash" class="form-label small fw-bold text-dark"></label> <span class="text-danger">*</span>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-cash"></i></span>
                                    <input asp-for="InputOpeningCash" type="number" step="1000" class="form-control border-start-0 fw-bold" style="color: var(--primary-green);" />
                                    <span class="input-group-text bg-white border-start-0 text-muted">VNĐ</span>
                                </div>
                                <small class="text-muted" style="font-size: 0.78rem;">
                                    Số tiền mặt thực tế kiểm đếm được trong két khi bắt đầu ca (tiền thối lẻ bàn giao).
                                </small>
                                <span asp-validation-for="InputOpeningCash" class="text-danger small d-block"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="InputOpeningNotes" class="form-label small fw-bold text-dark"></label>
                                <textarea asp-for="InputOpeningNotes" class="form-control" rows="2" placeholder="VD: Đã kiểm nhận đủ các mệnh giá 10k, 20k, 50k..."></textarea>
                            </div>

                            <div class="mb-4 p-3 rounded-3" style="background-color: #FFF9F0; border: 1px solid #FFE0B2;">
                                <div class="form-check">
                                    <input asp-for="IsOpeningCashConfirmed" class="form-check-input" id="confirmCheck" />
                                    <label class="form-check-label small fw-bold text-dark" for="confirmCheck">
                                        Tôi xác nhận đã kiểm đếm thực tế chính xác số tiền mặt đầu ca trong két.
                                    </label>
                                </div>
                                <span asp-validation-for="IsOpeningCashConfirmed" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-cafe-primary btn-lg rounded-pill fw-bold">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Bấm Mở Ca Làm Việc Mới
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ======================================================== -->
        <!-- TRƯỜNG HỢP 2: CASHIER ĐANG CÓ CA "OPEN" -->
        <!-- ======================================================== -->
        <div class="row g-4">
            <!-- Cột trái: Thông tin ca & Doanh thu tiền mặt -->
            <div class="col-lg-7">
                <!-- 3 Thẻ thống kê tiền mặt -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm p-3 rounded-4 text-center" 
                             style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                            <span class="text-muted small fw-semibold" style="font-size: 0.75rem;">TIỀN MẶT ĐẦU CA</span>
                            <h4 class="fw-bold mt-1 mb-0" style="color: var(--primary-green);">
                                @Model.CurrentShift!.OpeningCash.ToString("N0") đ
                            </h4>
                            <small class="text-success" style="font-size: 0.75rem;"><i class="bi bi-check-circle"></i> Đã kiểm đếm</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm p-3 rounded-4 text-center" 
                             style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                            <span class="text-muted small fw-semibold" style="font-size: 0.75rem;">TIỀN BÁN TẠI QUẦY</span>
                            <h4 class="fw-bold mt-1 mb-0" style="color: var(--primary-green);">
                                @Model.CurrentShift.SystemCashSales.ToString("N0") đ
                            </h4>
                            <small class="text-muted" style="font-size: 0.75rem;">(@Model.ShiftCashOrders.Count đơn tiền mặt)</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm p-3 rounded-4 text-center" 
                             style="background-color: #FFF9F0; border: 1px solid #FFE0B2 !important;">
                            <span class="text-dark small fw-bold" style="font-size: 0.75rem;">TIỀN DỰ KIẾN TRONG KÉT</span>
                            <h4 class="fw-bold mt-1 mb-0" style="color: #B76E00;">
                                @Model.ExpectedCash.ToString("N0") đ
                            </h4>
                            <small class="text-muted" style="font-size: 0.75rem;">Đầu ca + Doanh số + COD</small>
                        </div>
                    </div>
                </div>

                <!-- Danh sách đơn tiền mặt trong ca -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" 
                     style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                    <div class="card-header border-bottom p-3 d-flex justify-content-between align-items-center" 
                         style="background-color: #FAF7F2; border-color: var(--border-color) !important;">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-receipt me-2" style="color: var(--primary-green);"></i>Đơn Hàng Tiền Mặt Trong Ca
                        </h5>
                        <span class="badge rounded-pill bg-light text-dark border">@Model.ShiftCashOrders.Count đơn</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                            <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                                <thead style="background-color: #F8F5EE;" class="sticky-top">
                                    <tr class="text-muted small">
                                        <th class="ps-3 py-2">Mã đơn</th>
                                        <th class="py-2">Thời gian</th>
                                        <th class="py-2">Khách hàng</th>
                                        <th class="py-2">Món gọi</th>
                                        <th class="pe-3 py-2 text-end">Tổng tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.ShiftCashOrders.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">
                                                <i class="bi bi-inbox fs-3 d-block mb-1 opacity-50"></i>
                                                Chưa có đơn hàng thanh toán tiền mặt nào trong ca này.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var ord in Model.ShiftCashOrders)
                                        {
                                            <tr style="border-bottom: 1px solid var(--border-light);">
                                                <td class="ps-3 py-2 fw-bold" style="color: var(--primary-green);">#@ord.OrderCode</td>
                                                <td class="py-2 text-muted small">@ord.CreatedAt.ToString("HH:mm:ss")</td>
                                                <td class="py-2">@(ord.Customer?.FullName ?? "Khách vãng lai")</td>
                                                <td class="py-2 small text-muted">
                                                    @string.Join(", ", ord.OrderItems.Select(i => i.Variant?.Product != null ? $"{i.Quantity}x {i.Variant.Product.ProductName} ({i.Variant.SizeName})" : $"{i.Quantity}x Món #{i.VariantId}"))
                                                </td>
                                                <td class="pe-3 py-2 fw-bold text-end" style="color: var(--primary-green);">@ord.TotalAmount.ToString("N0") đ</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer p-3 d-flex justify-content-between align-items-center" 
                         style="background-color: #FAF7F2; border-color: var(--border-color) !important;">
                        <span class="small fw-semibold text-muted">Tổng tiền mặt bán tại quầy:</span>
                        <span class="fw-bold fs-6" style="color: var(--primary-green);">@Model.TotalCashSales.ToString("N0") đ</span>
                    </div>
                </div>

                @if (Model.ShiftCodDeliveries.Any())
                {
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3" 
                         style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                        <div class="card-header border-bottom p-3" style="background-color: #FAF7F2; border-color: var(--border-color) !important;">
                            <h5 class="fw-bold mb-0 text-dark">
                                <i class="bi bi-bicycle me-2" style="color: var(--primary-green);"></i>Tiền COD Shipper Bàn Giao Vào Ca (@Model.ShiftCodDeliveries.Count đơn)
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                                    <thead style="background-color: #F8F5EE;">
                                        <tr class="text-muted small">
                                            <th class="ps-3 py-2">Mã đơn</th>
                                            <th class="py-2">Người nhận</th>
                                            <th class="py-2">Shipper</th>
                                            <th class="pe-3 py-2 text-end">Tiền COD</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in Model.ShiftCodDeliveries)
                                        {
                                            <tr style="border-bottom: 1px solid var(--border-light);">
                                                <td class="ps-3 py-2 fw-bold" style="color: var(--primary-green);">#@d.Order.OrderCode</td>
                                                <td class="py-2">@d.RecipientName (@d.RecipientPhone)</td>
                                                <td class="py-2"><span class="badge rounded-pill bg-light text-dark border">@(d.DeliveryStaff?.FullName ?? "Shipper")</span></td>
                                                <td class="pe-3 py-2 fw-bold text-end" style="color: var(--primary-green);">@d.CodAmount.ToString("N0") đ</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer p-3 d-flex justify-content-between align-items-center" 
                             style="background-color: #FAF7F2; border-color: var(--border-color) !important;">
                            <span class="small fw-semibold text-muted">Tổng tiền COD nhận từ Shipper:</span>
                            <span class="fw-bold fs-6" style="color: var(--primary-green);">@Model.TotalCodSales.ToString("N0") đ</span>
                        </div>
                    </div>
                }
            </div>

            <!-- Cột phải: Form Đóng Ca & Bàn Giao Tiền Mặt -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden" 
                     style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                    <div class="card-header border-bottom p-3" style="background-color: var(--sidebar-bg); border-color: var(--border-color) !important;">
                        <h5 class="fw-bold text-white mb-0">
                            <i class="bi bi-lock-fill me-2" style="color: #FFE082;"></i>Đóng Ca Làm Việc & Đối Soát
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="p-3 mb-3 rounded-3 small" style="background-color: #FFF9F0; border: 1px solid #FFE0B2;">
                            <i class="bi bi-info-circle-fill me-1" style="color: var(--accent-caramel);"></i>
                            <strong>Lưu ý đối soát:</strong> Kiểm đếm cẩn thận toàn bộ tiền mặt trong két trước khi nhập. Hệ thống sẽ tự động tính chênh lệch thừa / thiếu tiền.
                        </div>

                        <div class="p-3 rounded-3 mb-3 small" style="background-color: #FAF7F2; border: 1px solid var(--border-subtle);">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Mã ca làm việc:</span>
                                <span class="fw-bold text-dark">#@Model.CurrentShift.ShiftId</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Thời gian mở ca:</span>
                                <span class="fw-semibold text-dark">@Model.CurrentShift.StartTime.ToString("dd/MM/yyyy HH:mm:ss")</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Tiền mặt dự kiến:</span>
                                <span class="fw-bold" style="color: var(--primary-green);">@Model.ExpectedCash.ToString("N0") đ</span>
                            </div>
                        </div>

                        <form asp-action="CloseShift" method="post" id="formCloseShift">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="ClosingActualCash" class="form-label small fw-bold text-dark"></label> <span class="text-danger">*</span>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-cash-stack"></i></span>
                                    <input asp-for="ClosingActualCash" type="number" step="1000" class="form-control border-start-0 fw-bold" 
                                           id="inputActualCash" placeholder="Nhập số tiền thực đếm" />
                                    <span class="input-group-text bg-white border-start-0 text-muted">VNĐ</span>
                                </div>
                                <span asp-validation-for="ClosingActualCash" class="text-danger small d-block"></span>
                            </div>

                            <!-- Live Discrepancy Box -->
                            <div id="discrepancyBox" class="p-3 rounded-3 mb-3 d-none">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="small fw-bold" id="discrepancyLabel">Chênh lệch:</span>
                                    <span class="fw-bold fs-6" id="discrepancyValue">0 đ</span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="HandoverNotes" class="form-label small fw-bold text-dark"></label>
                                <textarea asp-for="HandoverNotes" class="form-control" rows="3" placeholder="Ghi chú số lượng tờ tiền lẻ hoặc lý do chênh lệch thừa/thiếu (nếu có)..."></textarea>
                                <span asp-validation-for="HandoverNotes" class="text-danger small d-block"></span>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-cafe-primary btn-lg rounded-pill fw-bold" 
                                        onclick="return confirm('Bạn có chắc chắn muốn đóng ca và bàn giao số tiền này không?')">
                                    <i class="bi bi-check2-circle me-1"></i> Xác Nhận Đóng Ca & Bàn Giao
                                </button>
                                <a asp-action="POS" class="btn btn-cafe-outline rounded-pill text-center">
                                    <i class="bi bi-cart3 me-1"></i> Quay Lại Bán Hàng POS
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const expectedCash = @(Model.HasOpenShift ? Model.ExpectedCash : 0);
        const inputActual = document.getElementById('inputActualCash');
        const diffBox = document.getElementById('discrepancyBox');
        const diffLabel = document.getElementById('discrepancyLabel');
        const diffVal = document.getElementById('discrepancyValue');

        if (inputActual) {
            inputActual.addEventListener('input', function () {
                const actual = parseFloat(this.value);
                if (isNaN(actual)) {
                    diffBox.classList.add('d-none');
                    return;
                }
                diffBox.classList.remove('d-none');
                const diff = actual - expectedCash;

                if (diff === 0) {
                    diffBox.style.backgroundColor = '#EAF5EA';
                    diffBox.style.border = '1px solid #C8E6C9';
                    diffLabel.textContent = 'Khớp tiền hoàn hảo:';
                    diffLabel.style.color = 'var(--status-success)';
                    diffVal.textContent = '0 đ';
                    diffVal.style.color = 'var(--status-success)';
                } else if (diff < 0) {
                    diffBox.style.backgroundColor = '#FDF0F0';
                    diffBox.style.border = '1px solid #FFCDD2';
                    diffLabel.textContent = 'Thiếu tiền trong két:';
                    diffLabel.style.color = 'var(--status-danger)';
                    diffVal.textContent = diff.toLocaleString('vi-VN') + ' đ';
                    diffVal.style.color = 'var(--status-danger)';
                } else {
                    diffBox.style.backgroundColor = '#FFF9F0';
                    diffBox.style.border = '1px solid #FFE0B2';
                    diffLabel.textContent = 'Thừa tiền trong két:';
                    diffLabel.style.color = 'var(--accent-caramel)';
                    diffVal.textContent = '+' + diff.toLocaleString('vi-VN') + ' đ';
                    diffVal.style.color = 'var(--accent-caramel)';
                }
            });
        }
    </script>
}
