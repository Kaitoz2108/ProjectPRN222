@model CafeManagementSystem.Models.ViewModels.PosViewModel
@{
    ViewData["Title"] = "POS Bán Hàng Tại Quầy";
}

<div class="cafe-pos-wrapper py-3">
    <div class="container-fluid px-3 px-lg-4">
        
        <!-- Active Shift Header Banner (Photo 2) -->
        <div class="card border-0 shadow-sm rounded-4 mb-3" style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
            <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle" 
                              style="width: 36px; height: 36px; background-color: var(--primary-green-light); color: var(--primary-green);">
                            <i class="bi bi-shop fs-5"></i>
                        </span>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Màn Hình Thu Ngân POS</h5>
                            <span class="small text-muted" style="font-size: 0.8rem;">Bán hàng & ghi nhận doanh số tại quầy</span>
                        </div>
                    </div>

                    @if (Model.CurrentShift != null)
                    {
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="cafe-badge cafe-badge-success">
                                <i class="bi bi-record-circle-fill"></i> Ca #@Model.CurrentShift.ShiftId (Mở: @Model.CurrentShift.StartTime.ToString("HH:mm"))
                            </span>
                            <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #F0ECE4; color: var(--text-main);">
                                <i class="bi bi-cash-stack me-1 text-success"></i>Tiền mặt trong ca: <strong>@((Model.CurrentShift.SystemCashSales).ToString("N0")) đ</strong>
                            </span>
                        </div>
                    }
                    else
                    {
                        <span class="cafe-badge cafe-badge-danger">
                            <i class="bi bi-exclamation-octagon-fill"></i> Chưa mở ca bán hàng
                        </span>
                    }
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a asp-action="Shift" class="btn btn-cafe-outline d-inline-flex align-items-center gap-2">
                        <i class="bi bi-clock-history"></i>
                        <span>Quản lý ca / Đối soát</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- POS Workspace: Left (Menu) & Right (Order Ticket) -->
        <div class="row g-3">
            
            <!-- ======================================================== -->
            <!-- CỘT TRÁI: THỰC ĐƠN, LỌC DANH MỤC & CHỌN MÓN (COL-LG-7 / COL-XL-8) -->
            <!-- ======================================================== -->
            <div class="col-lg-7 col-xl-7">
                <div class="card border-0 shadow-sm rounded-4 h-100" style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                    
                    <!-- Search & Categories Bar -->
                    <div class="card-header border-0 bg-transparent p-3 pb-2">
                        <div class="row g-2 mb-3">
                            <div class="col-12">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: var(--radius-pill) 0 0 var(--radius-pill);">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" id="posSearchInput" class="form-control border-start-0" 
                                           placeholder="Tìm nhanh đồ uống theo tên..." 
                                           style="border-radius: 0 var(--radius-pill) var(--radius-pill) 0;" />
                                </div>
                            </div>
                        </div>

                        <!-- Category Filter Pills -->
                        <div class="d-flex gap-2 overflow-auto pb-1 flex-nowrap align-items-center">
                            <a asp-action="POS"
                               asp-route-categoryId=""
                               class="btn text-nowrap rounded-pill px-3 py-1 fw-semibold @(Model.SelectedCategoryId == null ? "btn-cafe-primary" : "btn-cafe-secondary")"
                               style="font-size: 0.88rem;">
                                Tất cả
                            </a>
                            @foreach (var cat in Model.Categories)
                            {
                                <a asp-action="POS"
                                   asp-route-categoryId="@cat.CategoryId"
                                   class="btn text-nowrap rounded-pill px-3 py-1 fw-semibold @(Model.SelectedCategoryId == cat.CategoryId ? "btn-cafe-primary" : "btn-cafe-secondary")"
                                   style="font-size: 0.88rem;">
                                    @cat.CategoryName
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Products Grid -->
                    <div class="card-body p-3 pt-1" style="max-height: calc(100vh - 270px); overflow-y: auto;">
                        <div class="row g-3" id="posProductGrid">
                            @foreach (var prod in Model.Products)
                            {
                                var activeVariants = prod.ProductVariants.Where(v => v.IsActive).OrderBy(v => v.Price).ToList();
                                var minPrice = activeVariants.Any() ? activeVariants.Min(v => v.Price) : 0;
                                // Lấy ảnh trực tiếp từ database
                                var imgUrl = !string.IsNullOrWhiteSpace(prod.ImageUrl) 
                                    ? prod.ImageUrl 
                                    : "/images/products/default.jpg";

                                var variantsJson = System.Text.Json.JsonSerializer.Serialize(activeVariants.Select(v => new {
                                    variantId = v.VariantId,
                                    sizeName = v.SizeName,
                                    price = v.Price
                                }));

                                <div class="col-6 col-md-4 col-xl-4 pos-prod-card" data-product-name="@prod.ProductName.ToLower()">
                                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative product-card-hover"
                                         style="background: #FFFFFF; border: 1px solid var(--border-color) !important;">
                                        
                                        <!-- Drink Image -->
                                        <div class="pos-prod-img-wrap">
                                            <img src="@imgUrl" alt="@prod.ProductName" 
                                                 class="pos-prod-img"
                                                 onerror="this.onerror=null; this.src='/images/products/default.jpg';" />
                                            <span class="position-absolute bottom-0 start-0 m-2 badge rounded-pill px-2 py-1 small"
                                                  style="background: rgba(0,0,0,0.65); color: #fff; font-size: 0.72rem;">
                                                @prod.Category.CategoryName
                                            </span>
                                        </div>

                                        <div class="card-body p-2 d-flex flex-column justify-content-between">
                                            <div>
                                                <h6 class="fw-bold text-dark mb-1 text-truncate" title="@prod.ProductName">@prod.ProductName</h6>
                                                <span class="fw-bold d-block" style="color: var(--primary-green); font-size: 0.95rem;">
                                                    @minPrice.ToString("N0") đ
                                                </span>
                                            </div>

                                            <button type="button" 
                                                    class="btn btn-cafe-primary btn-sm rounded-pill w-100 mt-2 fw-semibold btn-pos-open-modal"
                                                    data-product-id="@prod.ProductId"
                                                    data-product-name="@prod.ProductName"
                                                    data-product-desc="@(prod.Description ?? "")"
                                                    data-product-image="@imgUrl"
                                                    data-product-category="@prod.Category.CategoryName"
                                                    data-variants='@variantsJson'>
                                                <i class="bi bi-plus-lg me-1"></i> Chọn món
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ======================================================== -->
            <!-- CỘT PHẢI: KHÁCH HÀNG, ĐƠN HÀNG POS & THANH TOÁN (COL-LG-5 / COL-XL-5) -->
            <!-- ======================================================== -->
            <div class="col-lg-5 col-xl-5">
                <div class="cafe-pos-ticket shadow-sm" style="background-color: var(--surface-card); border: 1px solid var(--border-color);">
                    
                    <!-- 1. Customer Section (Photo 2) -->
                    <div class="p-3 border-bottom" style="border-color: var(--border-color) !important; background-color: #FAF7F2;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-uppercase" style="letter-spacing: 0.5px; color: var(--text-muted); font-size: 0.75rem;">
                                <i class="bi bi-person-circle me-1"></i> Khách hàng thành viên
                            </span>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 fw-bold" 
                                    style="color: var(--primary-green); font-size: 0.8rem;"
                                    data-bs-toggle="modal" data-bs-target="#createCustomerModal">
                                <i class="bi bi-person-plus-fill me-1"></i>+ Tạo khách mới
                            </button>
                        </div>

                        @if (Model.SelectedCustomer == null)
                        {
                            <form asp-action="SearchCustomer" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                                    <input type="text" name="searchPhone" class="form-control border-start-0" 
                                           placeholder="Nhập SĐT khách (VD: 0988888888)..." value="@Model.SearchPhone" />
                                    <button type="submit" class="btn btn-cafe-primary px-3">Tìm</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-3" 
                                 style="background-color: var(--primary-green-light); border: 1px solid rgba(53,87,70,0.2);">
                                <div>
                                    <div class="fw-bold" style="color: var(--primary-green);">@Model.SelectedCustomer.FullName</div>
                                    <div class="small text-muted" style="font-size: 0.8rem;">
                                        SĐT: @Model.SelectedCustomer.Phone 
                                        <span class="badge rounded-pill ms-1" style="background-color: #FFF3E0; color: var(--accent-caramel);">
                                            <i class="bi bi-stars"></i> @Model.SelectedCustomer.LoyaltyPoints.ToString("N0") điểm
                                        </span>
                                    </div>
                                </div>
                                <form asp-action="RemoveCustomer" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Đổi khách hàng">
                                        <i class="bi bi-x-circle-fill fs-5"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>

                    <!-- 2. Order Ticket Items List (Photo 2) -->
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--border-color) !important;">
                        <span class="fw-bold text-dark">
                            <i class="bi bi-receipt me-1" style="color: var(--primary-green);"></i> Chi tiết món gọi
                            <span class="badge rounded-pill bg-light text-dark border ms-1">@Model.CartItems.Sum(c => c.Quantity)</span>
                        </span>

                        @if (Model.CartItems.Any())
                        {
                            <form asp-action="ClearPosCart" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none small" 
                                        onclick="return confirm('Bạn có chắc muốn xóa toàn bộ món trong đơn?')">
                                    <i class="bi bi-trash"></i> Xóa đơn
                                </button>
                            </form>
                        }
                    </div>

                    <!-- Scrollable items container -->
                    <div class="flex-grow-1 p-2" style="overflow-y: auto; max-height: 240px;">
                        @if (!Model.CartItems.Any())
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-cup-straw fs-2 d-block mb-1 opacity-50"></i>
                                <span class="small">Chưa có món nào. Chọn đồ uống từ menu bên trái.</span>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @for (int i = 0; i < Model.CartItems.Count; i++)
                                {
                                    var item = Model.CartItems[i];
                                    <div class="p-2 rounded-3 bg-white border d-flex justify-content-between align-items-center shadow-xs"
                                         style="border-color: var(--border-light) !important;">
                                        <div class="d-flex align-items-center gap-2 text-truncate me-2" style="max-width: 65%;">
                                            <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/products/default.jpg" : item.ImageUrl)" 
                                                 alt="" class="cafe-thumb-sm" 
                                                 onerror="this.onerror=null; this.src='/images/products/default.jpg';" />
                                            <div class="text-truncate">
                                                <div class="fw-bold text-dark text-truncate" style="font-size: 0.9rem;">
                                                    @item.ProductName 
                                                    <span class="badge rounded-pill bg-light text-secondary border">@item.SizeName</span>
                                                </div>
                                                <div class="text-muted small" style="font-size: 0.75rem;">
                                                    Đường: @item.SugarLevel • Đá: @item.IceLevel
                                                    @if (!string.IsNullOrEmpty(item.ItemNote))
                                                    {
                                                        <span class="text-danger fst-italic">(@item.ItemNote)</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge rounded-pill px-2 py-1 fw-bold" style="background-color: #F0ECE4; color: var(--text-main);">
                                                x@item.Quantity
                                            </span>
                                            <span class="fw-bold text-dark" style="font-size: 0.9rem;">
                                                @item.LineTotal.ToString("N0") đ
                                            </span>
                                            <form asp-action="RemoveFromPosCart" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="index" value="@i" />
                                                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Xóa món">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- 3. Billing & Payment Controls (Photo 2) -->
                    <div class="p-3 border-top mt-auto" style="border-color: var(--border-color) !important; background-color: #FCFAF6;">
                        <form asp-action="CheckoutPosOrder" method="post" id="posCheckoutForm">
                            @Html.AntiForgeryToken()

                            <!-- Subtotal -->
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Tạm tính (Subtotal):</span>
                                <span class="fw-bold text-dark">@Model.SubTotal.ToString("N0") đ</span>
                            </div>

                            <!-- Loyalty Points Discount -->
                            @if (Model.SelectedCustomer != null && Model.SelectedCustomer.LoyaltyPoints > 0 && Model.SubTotal > 0)
                            {
                                <div class="p-2 mb-2 rounded-3" style="background-color: #FFF9F0; border: 1px dashed var(--accent-caramel);">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small fw-semibold text-dark">
                                            <i class="bi bi-stars" style="color: var(--accent-caramel);"></i> Dùng điểm (1đ = 1.000đ):
                                        </span>
                                        <span class="small badge rounded-pill" style="background: #FFE0B2; color: #B76E00;">
                                            Tối đa: @Model.MaxPointsUsable điểm
                                        </span>
                                    </div>
                                    <div class="input-group input-group-sm">
                                        <input type="number" name="pointsUsed" id="posPointsInput" class="form-control text-end fw-bold"
                                               value="@Model.PointsUsed" min="0" max="@Model.MaxPointsUsable" onchange="updatePosTotal()" />
                                        <span class="input-group-text bg-white">Điểm</span>
                                    </div>
                                    <div class="text-end small text-success mt-1 fw-bold" id="posDiscountPreview">
                                        -@Model.DiscountAmount.ToString("N0") đ
                                    </div>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" name="pointsUsed" value="0" />
                            }

                            <!-- Payment Method Choice (Tactile Buttons) -->
                            <div class="mb-2">
                                <label class="small fw-bold text-muted d-block mb-1">Phương thức thanh toán:</label>
                                <div class="d-flex gap-2">
                                    <label class="btn-cafe-option flex-fill text-center">
                                        <input type="radio" name="paymentMethod" value="Cash" checked />
                                        <span class="d-flex align-items-center justify-content-center gap-1 py-2">
                                            <i class="bi bi-cash-stack text-success"></i> Tiền mặt
                                        </span>
                                    </label>
                                    <label class="btn-cafe-option flex-fill text-center">
                                        <input type="radio" name="paymentMethod" value="Transfer" />
                                        <span class="d-flex align-items-center justify-content-center gap-1 py-2">
                                            <i class="bi bi-qr-code text-primary"></i> Chuyển khoản
                                        </span>
                                    </label>
                                </div>
                            </div>

                            <!-- Order Note -->
                            <div class="mb-3">
                                <input type="text" name="orderNote" class="form-control form-control-sm" 
                                       placeholder="Ghi chú chung cho toàn bộ đơn hàng..." />
                            </div>

                            <!-- Total & Checkout Action -->
                            <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-3 text-white"
                                 style="background-color: var(--sidebar-bg);">
                                <div>
                                    <span class="small d-block text-white-50">TỔNG CẦN THANH TOÁN</span>
                                    <small style="color: #FFE082;">
                                        <i class="bi bi-star-fill"></i> Tích +@((int)(Model.TotalAmount / 10000)) điểm
                                    </small>
                                </div>
                                <h3 class="fw-bold mb-0" style="color: #FFE082;" id="posTotalDisplay">
                                    @Model.TotalAmount.ToString("N0") đ
                                </h3>
                            </div>

                            <!-- Prominent Checkout Button -->
                            <button type="submit" class="btn btn-cafe-primary w-100 rounded-pill py-3 fw-bold fs-6 shadow-sm @(!Model.CartItems.Any() ? "disabled" : "")" 
                                    id="btnPosCheckout" style="background-color: var(--primary-green) !important;">
                                <i class="bi bi-check2-circle fs-5 me-1"></i> THANH TOÁN ĐƠN TẠI QUẦY
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL CHỌN MÓN TẠI QUẦY (Photo 2 POS Drink Customizer)
     ========================================================================= -->
<div class="modal fade" id="modalPosDrink" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-action="AddToPosCart" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />

                <div class="modal-header border-bottom p-3" style="background-color: #FAF7F2;">
                    <div class="d-flex align-items-center gap-2">
                        <img id="posModalImg" src="/images/products/default.jpg" alt="" class="rounded-3 object-fit-cover" style="width: 48px; height: 48px;" />
                        <div>
                            <h5 class="fw-bold text-dark mb-0" id="posModalTitle">Tên đồ uống</h5>
                            <span class="small text-muted" id="posModalCategory">Danh mục</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-3">
                    <!-- Size -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">Chọn Kích Cỡ (Size):</label>
                        <div class="d-flex gap-2 flex-wrap" id="posModalSizeContainer">
                            <!-- Populated dynamically -->
                        </div>
                    </div>

                    <!-- Sugar & Ice -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-dark mb-1">Mức đường:</label>
                            <select name="sugarLevel" class="form-select form-select-sm">
                                <option value="100%">100% đường</option>
                                <option value="70%">70% đường</option>
                                <option value="50%">50% đường</option>
                                <option value="30%">30% đường</option>
                                <option value="0%">Không đường</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-dark mb-1">Mức đá:</label>
                            <select name="iceLevel" class="form-select form-select-sm">
                                <option value="100%">100% đá</option>
                                <option value="70%">70% đá</option>
                                <option value="50%">50% đá</option>
                                <option value="Ít đá">Ít đá</option>
                                <option value="Không đá">Không đá</option>
                            </select>
                        </div>
                    </div>

                    <!-- Quantity & Note -->
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <label class="form-label small fw-bold text-dark mb-1">Số lượng:</label>
                            <input type="number" name="quantity" class="form-control form-control-sm text-center fw-bold" value="1" min="1" max="99" />
                        </div>
                        <div class="col-8">
                            <label class="form-label small fw-bold text-dark mb-1">Ghi chú món:</label>
                            <input type="text" name="itemNote" class="form-control form-control-sm" placeholder="VD: ít sữa, đá riêng..." />
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top p-3" style="background-color: #FAF7F2;">
                    <button type="button" class="btn btn-cafe-outline btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-cafe-primary btn-sm rounded-pill px-4 fw-bold">
                        <i class="bi bi-plus-circle me-1"></i> Thêm vào đơn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL TẠO NHANH KHÁCH HÀNG TẠI QUẦY (Photo 2)
     ========================================================================= -->
<div class="modal fade" id="createCustomerModal" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-action="CreateCustomer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />

                <div class="modal-header border-bottom p-3" style="background-color: #FAF7F2;">
                    <h5 class="modal-title fw-bold text-dark" id="modalLabel">
                        <i class="bi bi-person-plus-fill me-2" style="color: var(--primary-green);"></i>Tạo Khách Hàng Mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Họ và tên khách: <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control" required placeholder="VD: Nguyễn Văn A" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Số điện thoại: <span class="text-danger">*</span></label>
                        <input type="text" name="phone" class="form-control" required placeholder="VD: 0912345678" />
                        <div class="small text-muted mt-1">Dùng để tra cứu & tích lũy điểm các lần sau.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Email:</label>
                        <input type="email" name="email" class="form-control" placeholder="VD: customer@gmail.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Địa chỉ:</label>
                        <input type="text" name="address" class="form-control" placeholder="VD: 123 Lê Lợi, Quận 1" />
                    </div>
                </div>
                <div class="modal-footer border-top p-3" style="background-color: #FAF7F2;">
                    <button type="button" class="btn btn-cafe-outline btn-sm" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-cafe-primary btn-sm rounded-pill px-4 fw-bold">
                        <i class="bi bi-check-lg me-1"></i> Lưu & Chọn Khách
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Live search drinks in POS menu
        document.getElementById('posSearchInput')?.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            document.querySelectorAll('.pos-prod-card').forEach(card => {
                const name = card.getAttribute('data-product-name') || '';
                card.style.display = name.includes(query) ? '' : 'none';
            });
        });

        // POS Drink Customizer Modal
        const posModalEl = document.getElementById('modalPosDrink');
        const posModal = new bootstrap.Modal(posModalEl);

        document.querySelectorAll('.btn-pos-open-modal').forEach(btn => {
            btn.addEventListener('click', function () {
                const name = this.getAttribute('data-product-name');
                const img = this.getAttribute('data-product-image');
                const cat = this.getAttribute('data-product-category');
                const rawVariants = this.getAttribute('data-variants');
                let variants = [];
                try { variants = JSON.parse(rawVariants) || []; } catch(e) {}

                document.getElementById('posModalTitle').textContent = name;
                document.getElementById('posModalImg').src = img || '/images/products/default.jpg';
                document.getElementById('posModalCategory').textContent = cat;

                const sizeContainer = document.getElementById('posModalSizeContainer');
                sizeContainer.innerHTML = '';
                
                // Khử trùng lặp size nếu có và chuẩn hóa tên hiển thị
                const seenSizes = new Set();
                const uniqueVariants = [];
                variants.forEach(v => {
                    const rawSize = (v.sizeName || '').trim();
                    const cleanSize = rawSize.replace(/^Size\s+/i, '').trim();
                    const key = cleanSize.toUpperCase();
                    if (!seenSizes.has(key)) {
                        seenSizes.add(key);
                        uniqueVariants.push({ ...v, displaySize: cleanSize });
                    }
                });

                uniqueVariants.forEach((v, idx) => {
                    const label = document.createElement('label');
                    label.className = 'btn-cafe-option flex-fill text-center';
                    label.innerHTML = `
                        <input type="radio" name="variantId" value="${v.variantId}" ${idx === 0 ? 'checked' : ''} required />
                        <div>
                            <div class="fw-bold">Size ${v.displaySize}</div>
                            <div class="small opacity-75">${v.price.toLocaleString('vi-VN')} đ</div>
                        </div>
                    `;
                    sizeContainer.appendChild(label);
                });

                posModal.show();
            });
        });

        // Calculation of Loyalty Points discount
        function updatePosTotal() {
            var subTotal = @Model.SubTotal;
            var pointsInput = document.getElementById('posPointsInput');
            if (!pointsInput) return;

            var points = parseInt(pointsInput.value) || 0;
            var maxPoints = parseInt(pointsInput.getAttribute('max')) || 0;

            if (points < 0) points = 0;
            if (points > maxPoints) points = maxPoints;
            pointsInput.value = points;

            var discount = points * 1000;
            var total = Math.max(0, subTotal - discount);

            var previewEl = document.getElementById('posDiscountPreview');
            if (previewEl) {
                previewEl.innerText = '-' + discount.toLocaleString('vi-VN') + ' đ';
            }
            document.getElementById('posTotalDisplay').innerText = total.toLocaleString('vi-VN') + ' đ';
        }
    </script>
}
