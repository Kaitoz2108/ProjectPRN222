@model CafeManagementSystem.Models.ViewModels.PosViewModel
@{
    ViewData["Title"] = "Bán Hàng Tại Quầy POS";
}

<div class="container-fluid py-2">
    <!-- Thanh trạng thái thu ngân & ca làm việc -->
    <div class="d-flex justify-content-between align-items-center bg-white px-3 py-2 rounded-3 shadow-sm mb-3 border">
        <div class="d-flex align-items-center gap-3">
            <span class="fs-5 fw-bold text-primary">
                <i class="bi bi-shop-window me-2"></i>Màn Hình Bán Hàng Tại Quầy (POS)
            </span>
            <span class="badge bg-success">
                <i class="bi bi-check-circle me-1"></i> Ca #@Model.CurrentShift?.ShiftId (Mở lúc: @Model.CurrentShift?.StartTime.ToString("HH:mm"))
            </span>
            <span class="badge bg-info text-dark">
                Tiền mặt bán trong ca: @((Model.CurrentShift?.SystemCashSales ?? 0).ToString("N0")) đ
            </span>
        </div>
        <div>
            <a asp-action="Shift" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-clock-history me-1"></i> Quản Lý Ca / Đóng Ca
            </a>
        </div>
    </div>

    <div class="row g-3">
        <!-- ======================================================== -->
        <!-- CỘT TRÁI: THỰC ĐƠN, LỌC DANH MỤC & CHỌN MÓN (COL-LG-7) -->
        <!-- ======================================================== -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <!-- Danh mục lọc -->
                    <div class="d-flex gap-2 overflow-auto pb-1 flex-nowrap">
                        <a asp-action="POS"
                           asp-route-categoryId=""
                           class="btn btn-sm text-nowrap rounded-pill @(Model.SelectedCategoryId == null ? "btn-primary" : "btn-outline-secondary")">
                            <i class="bi bi-grid-fill me-1"></i> Tất cả
                        </a>
                        @foreach (var cat in Model.Categories)
                        {
                            <a asp-action="POS"
                               asp-route-categoryId="@cat.CategoryId"
                               class="btn btn-sm text-nowrap rounded-pill @(Model.SelectedCategoryId == cat.CategoryId ? "btn-primary" : "btn-outline-secondary")">
                                @cat.CategoryName
                            </a>
                        }
                    </div>
                </div>

                <div class="card-body p-3" style="max-height: 720px; overflow-y: auto;">
                    <div class="row g-3">
                        @foreach (var prod in Model.Products)
                        {
                            <div class="col-md-6">
                                <div class="card h-100 border shadow-sm rounded-3">
                                    <div class="card-body p-3 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="fw-bold text-dark mb-0">@prod.ProductName</h6>
                                            <span class="badge bg-light text-secondary border">@prod.Category.CategoryName</span>
                                        </div>
                                        <p class="small text-muted mb-2 text-truncate">@(prod.Description ?? "Đồ uống tươi ngon pha chế tại chỗ.")</p>

                                        <!-- Form thêm món vào giỏ hàng POS -->
                                        <form asp-action="AddToPosCart" method="post" class="mt-auto">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />

                                            <!-- Chọn Biến thể / Size -->
                                            <div class="mb-2">
                                                <label class="form-label small fw-semibold mb-1">Chọn kích cỡ (Size):</label>
                                                <select name="variantId" class="form-select form-select-sm" required>
                                                    @foreach (var v in prod.ProductVariants.OrderBy(v => v.Price))
                                                    {
                                                        <option value="@v.VariantId">
                                                            Size @v.SizeName - @v.Price.ToString("N0") đ
                                                        </option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="row g-1 mb-2">
                                                <!-- Chọn Mức đường -->
                                                <div class="col-6">
                                                    <label class="form-label small fw-semibold mb-1">Đường:</label>
                                                    <select name="sugarLevel" class="form-select form-select-sm">
                                                        <option value="100%">100% đường</option>
                                                        <option value="70%">70% đường</option>
                                                        <option value="50%">50% đường</option>
                                                        <option value="30%">30% đường</option>
                                                        <option value="0%">0% (Không đường)</option>
                                                    </select>
                                                </div>

                                                <!-- Chọn Mức đá -->
                                                <div class="col-6">
                                                    <label class="form-label small fw-semibold mb-1">Đá:</label>
                                                    <select name="iceLevel" class="form-select form-select-sm">
                                                        <option value="100%">100% đá</option>
                                                        <option value="Ít đá">Ít đá</option>
                                                        <option value="Không đá">Không đá</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="row g-1 mb-2">
                                                <!-- Số lượng -->
                                                <div class="col-4">
                                                    <input type="number" name="quantity" class="form-control form-control-sm text-center fw-bold" value="1" min="1" max="99" />
                                                </div>
                                                <!-- Ghi chú món -->
                                                <div class="col-8">
                                                    <input type="text" name="itemNote" class="form-control form-control-sm" placeholder="Ghi chú (ít ngọt...)" />
                                                </div>
                                            </div>

                                            <button type="submit" class="btn btn-sm btn-primary w-100 fw-semibold">
                                                <i class="bi bi-plus-circle me-1"></i> Thêm Vào Đơn
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ======================================================== -->
        <!-- CỘT PHẢI: KHÁCH HÀNG, GIỎ HÀNG POS & THANH TOÁN (COL-LG-5) -->
        <!-- ======================================================== -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 mb-3">
                <!-- 1. TÌM KIẾM & TẠO KHÁCH HÀNG (Customer Information & Customer Data) -->
                <div class="card-header bg-light py-2 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold small text-secondary">
                            <i class="bi bi-person-badge me-1"></i> THÔNG TIN KHÁCH HÀNG
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-success py-0 px-2" data-bs-toggle="modal" data-bs-target="#createCustomerModal">
                            <i class="bi bi-person-plus-fill me-1"></i> Tạo Nhanh Khách Mới
                        </button>
                    </div>
                </div>
                <div class="card-body p-3">
                    @if (Model.SelectedCustomer == null)
                    {
                        <!-- Form tìm kiếm khách theo SĐT -->
                        <form asp-action="SearchCustomer" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" name="searchPhone" class="form-control" placeholder="Nhập SĐT khách hàng (VD: 0988888888)..." value="@Model.SearchPhone" />
                                <button type="submit" class="btn btn-primary">Tìm</button>
                            </div>
                        </form>
                        <div class="text-muted small mt-1">
                            <i class="bi bi-info-circle me-1"></i> Khách vãng lai nếu không nhập SĐT.
                        </div>
                    }
                    else
                    {
                        <!-- Thẻ thông tin khách hàng đã chọn -->
                        <div class="d-flex justify-content-between align-items-center p-2 bg-success bg-opacity-10 border border-success rounded-3">
                            <div>
                                <h6 class="fw-bold text-success mb-0">@Model.SelectedCustomer.FullName</h6>
                                <small class="text-muted">SĐT: <strong>@Model.SelectedCustomer.Phone</strong></small>
                                <span class="badge bg-warning text-dark ms-2">
                                    <i class="bi bi-star-fill me-1"></i>@Model.SelectedCustomer.LoyaltyPoints.ToString("N0") điểm
                                </span>
                            </div>
                            <form asp-action="RemoveCustomer" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy chọn khách hàng">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>

            <!-- 2. BẢNG GIỎ HÀNG POS (PosCart) -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-white py-2 border-bottom d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark">
                        <i class="bi bi-cart3 me-1 text-primary"></i> Đơn Hàng Tại Quầy
                    </span>
                    @if (Model.CartItems.Any())
                    {
                        <form asp-action="ClearPosCart" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                            <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="return confirm('Bạn có chắc muốn xóa toàn bộ đơn?')">
                                <i class="bi bi-trash"></i> Xóa tất cả
                            </button>
                        </form>
                    }
                </div>

                <div class="card-body p-0" style="max-height: 250px; overflow-y: auto;">
                    @if (!Model.CartItems.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-cup-straw fs-2 d-block mb-1 opacity-50"></i>
                            <span>Chưa có món nào trong đơn. Vui lòng chọn từ menu bên trái.</span>
                        </div>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Món</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-end">Đơn Giá</th>
                                    <th class="text-end">Thành Tiền</th>
                                    <th style="width: 30px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.CartItems.Count; i++)
                                {
                                    var item = Model.CartItems[i];
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@item.ProductName <span class="badge bg-secondary">@item.SizeName</span></div>
                                            <div class="text-muted small" style="font-size: 0.78rem;">
                                                Đường: @item.SugarLevel | Đá: @item.IceLevel
                                                @if (!string.IsNullOrEmpty(item.ItemNote))
                                                {
                                                    <span class="text-danger fst-italic">(@item.ItemNote)</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center fw-bold">@item.Quantity</td>
                                        <td class="text-end text-muted small">@item.UnitPrice.ToString("N0")</td>
                                        <td class="text-end fw-bold text-dark">@item.LineTotal.ToString("N0")</td>
                                        <td class="text-center">
                                            <form asp-action="RemoveFromPosCart" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="index" value="@i" />
                                                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                                <button type="submit" class="btn btn-sm text-danger p-0 border-0 bg-transparent" title="Xóa món">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <!-- 3. TÍNH TIỀN, ĐIỂM TÍCH LŨY & THANH TOÁN (Counter Order Data) -->
            <div class="card shadow-sm border-0 border-top border-primary border-3">
                <div class="card-body p-3">
                    <form asp-action="CheckoutPosOrder" method="post" id="checkoutForm">
                        @Html.AntiForgeryToken()

                        <!-- Tạm tính -->
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính (Subtotal):</span>
                            <span class="fw-bold fs-6">@Model.SubTotal.ToString("N0") đ</span>
                        </div>

                        <!-- Điểm tích lũy (nếu khách hàng có điểm) -->
                        @if (Model.SelectedCustomer != null && Model.SelectedCustomer.LoyaltyPoints > 0 && Model.SubTotal > 0)
                        {
                            <div class="p-2 mb-2 bg-warning bg-opacity-10 border border-warning rounded-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small fw-semibold text-dark">
                                        <i class="bi bi-star-fill text-warning me-1"></i> Dùng điểm tích lũy (1đ = 1.000đ):
                                    </span>
                                    <span class="badge bg-warning text-dark">Tối đa: @Model.MaxPointsUsable điểm</span>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="number" name="pointsUsed" id="pointsInput" class="form-control text-end fw-bold"
                                           value="@Model.PointsUsed" min="0" max="@Model.MaxPointsUsable" onchange="updateTotal()" />
                                    <span class="input-group-text">Điểm</span>
                                </div>
                                <div class="text-end small text-success mt-1 fw-semibold" id="discountPreview">
                                    -@Model.DiscountAmount.ToString("N0") đ
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="pointsUsed" value="0" />
                        }

                        <!-- Phương thức thanh toán -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold mb-1">Phương thức thanh toán:</label>
                            <div class="d-flex gap-2">
                                <div class="form-check form-check-inline border rounded p-2 flex-grow-1 text-center bg-light">
                                    <input class="form-check-input" type="radio" name="paymentMethod" id="payCash" value="Cash" checked>
                                    <label class="form-check-label fw-bold text-success" for="payCash">
                                        <i class="bi bi-cash me-1"></i> Tiền Mặt (Cash)
                                    </label>
                                </div>
                                <div class="form-check form-check-inline border rounded p-2 flex-grow-1 text-center bg-light">
                                    <input class="form-check-input" type="radio" name="paymentMethod" id="payTransfer" value="Transfer">
                                    <label class="form-check-label fw-bold text-primary" for="payTransfer">
                                        <i class="bi bi-qr-code me-1"></i> Chuyển Khoản
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Ghi chú đơn -->
                        <div class="mb-3">
                            <input type="text" name="orderNote" class="form-control form-control-sm" placeholder="Ghi chú chung cho toàn bộ đơn hàng (nếu có)..." />
                        </div>

                        <!-- Tổng tiền thanh toán -->
                        <div class="d-flex justify-content-between align-items-center p-3 bg-dark text-white rounded-3 mb-3">
                            <div>
                                <span class="text-white-50 small d-block">TỔNG THANH TOÁN</span>
                                <small class="text-warning">
                                    <i class="bi bi-plus-circle me-1"></i> Tích +@((int)(Model.TotalAmount / 10000)) điểm mới
                                </small>
                            </div>
                            <h3 class="fw-bold text-warning mb-0" id="totalDisplay">
                                @Model.TotalAmount.ToString("N0") đ
                            </h3>
                        </div>

                        <!-- Nút thanh toán -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg fw-bold py-2 @(!Model.CartItems.Any() ? "disabled" : "")" id="btnCheckout">
                                <i class="bi bi-check-circle-fill me-1"></i> THANH TOÁN ĐƠN TẠI QUẦY
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- BOOTSTRAP MODAL: TẠO NHANH KHÁCH HÀNG TẠI QUẦY (Customer Data) -->
<!-- ======================================================== -->
<div class="modal fade" id="createCustomerModal" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateCustomer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />

                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="modalLabel">
                        <i class="bi bi-person-plus-fill me-2"></i>Tạo Nhanh Khách Hàng Mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-toggle="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên khách hàng: <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control" required placeholder="VD: Hoàng Văn Nam" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số điện thoại: <span class="text-danger">*</span></label>
                        <input type="text" name="phone" class="form-control" required placeholder="VD: 0912345678" />
                        <small class="text-muted">Dùng để tra cứu điểm tích lũy trong các lần mua sau.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email:</label>
                        <input type="email" name="email" class="form-control" placeholder="VD: customer@gmail.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Địa chỉ:</label>
                        <input type="text" name="address" class="form-control" placeholder="VD: Phường Bến Nghé, Quận 1" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success fw-semibold">
                        <i class="bi bi-save me-1"></i> Lưu & Chọn Khách Này
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateTotal() {
            var subTotal = @Model.SubTotal;
            var pointsInput = document.getElementById('pointsInput');
            if (!pointsInput) return;

            var points = parseInt(pointsInput.value) || 0;
            var maxPoints = parseInt(pointsInput.getAttribute('max')) || 0;

            if (points < 0) points = 0;
            if (points > maxPoints) points = maxPoints;
            pointsInput.value = points;

            var discount = points * 1000;
            var total = Math.max(0, subTotal - discount);

            document.getElementById('discountPreview').innerText = '-' + discount.toLocaleString('vi-VN') + ' đ';
            document.getElementById('totalDisplay').innerText = total.toLocaleString('vi-VN') + ' đ';
        }
    </script>
}
