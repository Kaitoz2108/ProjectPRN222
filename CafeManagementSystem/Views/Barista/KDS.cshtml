@model CafeManagementSystem.Models.ViewModels.KdsIndexViewModel
@{
    ViewData["Title"] = "Màn hình KDS Pha Chế";
}
<meta http-equiv="refresh" content="15">

<div class="container-fluid py-3 px-3 px-lg-4">
    <!-- Header Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 pb-2 border-bottom" style="border-color: var(--border-color) !important;">
        <div>
            <h2 class="fw-bold text-dark mb-1">Màn hình điều phối quầy bar (KDS)</h2>
            <p class="text-muted small mb-0">Hàng đợi món nước chờ pha chế và điều phối ra quầy nhận / shipper</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="cafe-badge cafe-badge-warning">
                <i class="bi bi-hourglass-split"></i> Chờ làm: <strong>@Model.TotalPendingCount</strong>
            </span>
            <span class="cafe-badge" style="background-color: var(--primary-green-light); color: var(--primary-green);">
                <i class="bi bi-cup-hot-fill"></i> Đang pha: <strong>@Model.TotalPreparingCount</strong>
            </span>
            <span class="badge rounded-pill bg-light text-dark border px-3 py-2 fw-semibold">
                <i class="bi bi-cup-straw me-1"></i> Tổng ly: @Model.TotalCupsWaiting
            </span>
            <a class="btn btn-cafe-outline rounded-pill btn-sm d-inline-flex align-items-center gap-1" asp-controller="Barista" asp-action="Wastage">
                <i class="bi bi-box-seam"></i> Kho quầy & Hao hụt
            </a>
        </div>
    </div>

    @if (!Model.Orders.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5" 
             style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
            <div class="card-body py-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                     style="width: 72px; height: 72px; background-color: var(--primary-green-light); color: var(--primary-green);">
                    <i class="bi bi-check-circle-fill fs-2"></i>
                </div>
                <h4 class="fw-bold text-dark">Hiện tại không có món nước nào đang chờ pha chế</h4>
                <p class="text-muted small mb-0">Tất cả đơn hàng đã được phục vụ. Trang sẽ tự động tải lại sau 15 giây.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var order in Model.Orders)
            {
                var isLongWait = order.ElapsedMinutes > 10;
                var isPreparing = order.PreparationStatus == "Preparing";

                <div class="col-md-6 col-lg-4 col-xl-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden" 
                         style="background-color: var(--surface-card); border: 1.5px solid @(isPreparing ? "var(--primary-green)" : "var(--accent-caramel)") !important;">
                        
                        <!-- Header Ticket -->
                        <div class="p-3 d-flex justify-content-between align-items-center text-white"
                             style="background-color: @(isPreparing ? "var(--primary-green)" : "var(--accent-caramel)");">
                            <span class="fw-bold fs-6">#@order.OrderCode</span>
                            <span class="badge rounded-pill px-3 py-1 fw-bold" style="background-color: rgba(255,255,255,0.25); color: #FFFFFF;">
                                @(isPreparing ? "Đang pha chế" : "Chờ nhận đơn")
                            </span>
                        </div>

                        <!-- Ticket Body -->
                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div>
                                <!-- Time & Meta Chips -->
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom" style="border-color: var(--border-light) !important;">
                                    <span class="text-muted small" style="font-size: 0.8rem;">
                                        <i class="bi bi-clock me-1"></i>@order.CreatedAt.ToString("HH:mm:ss")
                                    </span>
                                    <span class="badge rounded-pill @(isLongWait ? "bg-danger text-white" : "bg-light text-dark border")" style="font-size: 0.78rem;">
                                        Chờ: @order.ElapsedMinutes phút
                                    </span>
                                    <span class="badge rounded-pill bg-light text-dark border" style="font-size: 0.75rem;">
                                        @(order.OrderSource == "OnlineDelivery" ? "Online" : "Tại quầy")
                                    </span>
                                </div>

                                @if (!string.IsNullOrEmpty(order.CustomerName))
                                {
                                    <div class="small text-muted mb-2" style="font-size: 0.82rem;">
                                        <i class="bi bi-person me-1 text-dark"></i><strong>@order.CustomerName</strong> @(string.IsNullOrEmpty(order.CustomerPhone) ? "" : $"({order.CustomerPhone})")
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(order.OrderNote))
                                {
                                    <div class="p-2 rounded-3 small mb-2" style="background-color: #FFF9F0; border: 1px dashed var(--accent-caramel); font-size: 0.78rem;">
                                        <strong>Ghi chú:</strong> @order.OrderNote
                                    </div>
                                }

                                <!-- Items List -->
                                <div class="d-flex flex-column gap-2 my-2">
                                    @foreach (var item in order.Items)
                                    {
                                        <div class="p-2 rounded-3 bg-white border" style="border-color: var(--border-subtle) !important;">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong class="text-dark">@item.Quantity x @item.ProductName</strong>
                                                <span class="badge rounded-pill bg-light text-dark border">Size @item.SizeName</span>
                                            </div>
                                            <div class="small text-muted" style="font-size: 0.78rem;">
                                                <span>Đường: @(item.SugarLevel ?? "100%")</span> • <span>Đá: @(item.IceLevel ?? "100%")</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(item.ItemNote))
                                            {
                                                <div class="small fst-italic" style="color: var(--status-danger); font-size: 0.75rem;">
                                                    Note: @item.ItemNote
                                                </div>
                                            }

                                            <!-- Collapsible Recipe BOM Guide -->
                                            @if (item.Recipes.Any())
                                            {
                                                <div class="mt-2 pt-2 border-top" style="border-color: var(--border-light) !important;">
                                                    <button class="btn btn-link btn-sm p-0 text-decoration-none small" 
                                                            style="color: var(--primary-green); font-size: 0.75rem;"
                                                            type="button" data-bs-toggle="collapse" data-bs-target="#recipe_@order.OrderId@(System.Math.Abs(item.GetHashCode()))">
                                                        <i class="bi bi-journal-text me-1"></i> Xem định lượng công thức
                                                    </button>
                                                    <div class="collapse mt-1" id="recipe_@order.OrderId@(System.Math.Abs(item.GetHashCode()))">
                                                        <div class="table-responsive">
                                                            <table class="table table-sm table-bordered mb-0" style="font-size: 0.75rem;">
                                                                <thead style="background-color: #F8F5EE;">
                                                                    <tr>
                                                                        <th>Nguyên liệu</th>
                                                                        <th>Định lượng</th>
                                                                        <th>Tồn</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var r in item.Recipes)
                                                                    {
                                                                        <tr class="@(r.IsLowStock ? "table-danger" : "")">
                                                                            <td>@r.IngredientName</td>
                                                                            <td>@r.TotalQuantityRequired.ToString("0.##") @r.Unit</td>
                                                                            <td>@r.CurrentStock.ToString("0.##")</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Action Button -->
                            <div class="pt-3 border-top mt-2" style="border-color: var(--border-light) !important;">
                                @if (order.PreparationStatus == "Pending")
                                {
                                    <form asp-controller="Barista" asp-action="UpdatePreparationStatus" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <input type="hidden" name="newStatus" value="Preparing" />
                                        <button class="btn btn-cafe-caramel w-100 rounded-pill fw-bold py-2">
                                            <i class="bi bi-play-fill me-1"></i> Bắt đầu pha chế
                                        </button>
                                    </form>
                                }
                                else if (order.PreparationStatus == "Preparing")
                                {
                                    <form asp-controller="Barista" asp-action="UpdatePreparationStatus" method="post" onsubmit="return confirm('Xác nhận hoàn tất đơn và trừ kho tự động theo công thức?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <input type="hidden" name="newStatus" value="Ready" />
                                        <button class="btn btn-cafe-primary w-100 rounded-pill fw-bold py-2">
                                            <i class="bi bi-check-lg me-1"></i> Hoàn tất & Trừ kho
                                        </button>
                                    </form>
                                }

                                @if (!string.IsNullOrEmpty(order.BaristaName))
                                {
                                    <div class="text-muted text-center mt-1" style="font-size: 0.75rem;">Barista: @order.BaristaName</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
