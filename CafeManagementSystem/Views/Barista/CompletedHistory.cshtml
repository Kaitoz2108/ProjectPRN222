@model CafeManagementSystem.Models.ViewModels.CompletedHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử Đơn đã pha chế";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-clock-history text-success me-2"></i>Lịch Sử Đơn Đã Pha Chế</h3>
            <p class="text-muted mb-0">Tra cứu các đơn đã hoàn tất theo thời gian, mã đơn và khách hàng</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-dark" asp-controller="Barista" asp-action="KDS">
                <i class="bi bi-cup-hot me-1"></i> Quay lại KDS
            </a>
            <a class="btn btn-outline-secondary" asp-controller="Barista" asp-action="Wastage">
                <i class="bi bi-box-seam me-1"></i> Kho Quầy Bar
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="Barista" asp-action="CompletedHistory" method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Từ ngày</label>
                    <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Đến ngày</label>
                    <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Tìm kiếm</label>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Mã đơn, tên hoặc SĐT khách hàng" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100"><i class="bi bi-search me-1"></i>Lọc</button>
                    <a asp-controller="Barista" asp-action="CompletedHistory" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success-subtle text-success p-3"><i class="bi bi-receipt fs-4"></i></div>
                    <div>
                        <div class="text-muted small">Tổng số đơn</div>
                        <div class="fs-4 fw-bold">@Model.TotalOrders</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary-subtle text-primary p-3"><i class="bi bi-cup-straw fs-4"></i></div>
                    <div>
                        <div class="text-muted small">Tổng số ly</div>
                        <div class="fs-4 fw-bold">@Model.TotalCups</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning-subtle text-warning p-3"><i class="bi bi-cash-coin fs-4"></i></div>
                    <div>
                        <div class="text-muted small">Tổng doanh thu</div>
                        <div class="fs-4 fw-bold">@Model.TotalRevenue.ToString("N0") đ</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white fw-bold">
            <i class="bi bi-list-check me-2 text-success"></i>Danh sách đơn đã pha chế
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Nguồn</th>
                            <th>Khách hàng</th>
                            <th>Barista</th>
                            <th>Đặt lúc</th>
                            <th>Hoàn tất lúc</th>
                            <th class="text-center">Thời gian</th>
                            <th class="text-center">Số ly</th>
                            <th class="text-end">Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Orders.Any())
                        {
                            <tr>
                                <td colspan="11" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                    Không có đơn hàng nào phù hợp với bộ lọc.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td class="fw-semibold">#@order.OrderCode</td>
                                    <td>
                                        @if (order.OrderSource == "Counter")
                                        {
                                            <span class="badge bg-secondary">Tại quầy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">Trực tuyến</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(order.CustomerName))
                                        {
                                            <div>@order.CustomerName</div>
                                            <div class="small text-muted">@order.CustomerPhone</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Khách lẻ</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(order.BaristaName) ? "—" : order.BaristaName)</td>
                                    <td class="small">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="small">
                                        @if (order.CompletedAt.HasValue)
                                        {
                                            @order.CompletedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(order.ProcessingMinutes > 10 ? "bg-danger" : "bg-success")">
                                            @order.ProcessingMinutes phút
                                        </span>
                                    </td>
                                    <td class="text-center">@order.TotalCups</td>
                                    <td class="text-end fw-semibold">@order.TotalAmount.ToString("N0") đ</td>
                                    <td>
                                        @if (order.PreparationStatus == "Completed")
                                        {
                                            <span class="badge bg-success">Đã hoàn tất</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">Ready</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-dark" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#items_@order.OrderId"
                                                aria-expanded="false" aria-controls="items_@order.OrderId">
                                            <i class="bi bi-chevron-expand"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr class="collapse" id="items_@order.OrderId">
                                    <td colspan="11" class="bg-light">
                                        <div class="p-2">
                                            <div class="fw-semibold small mb-2">
                                                <i class="bi bi-cup-hot me-1"></i>Chi tiết món
                                            </div>
                                            <ul class="list-group list-group-flush">
                                                @foreach (var item in order.Items)
                                                {
                                                    <li class="list-group-item bg-transparent px-0 py-1 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                        <span>
                                                            <strong>@item.Quantity x @item.ProductName</strong>
                                                            <span class="badge bg-secondary ms-1">Size @item.SizeName</span>
                                                            @if (!string.IsNullOrEmpty(item.ItemNote))
                                                            {
                                                                <span class="text-danger fst-italic ms-2 small">Note: @item.ItemNote</span>
                                                            }
                                                        </span>
                                                        <span class="small text-muted">Đường: @(item.SugarLevel ?? "100%") | Đá: @(item.IceLevel ?? "100%")</span>
                                                    </li>
                                                }
                                            </ul>
                                            @if (!string.IsNullOrEmpty(order.OrderNote))
                                            {
                                                <div class="alert alert-secondary py-1 px-2 small mt-2 mb-0">
                                                    Ghi chú đơn: @order.OrderNote
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
