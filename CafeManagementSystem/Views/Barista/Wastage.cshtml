@model CafeManagementSystem.Models.ViewModels.WastagePageViewModel
@{
    ViewData["Title"] = "Kho Quầy Bar & Báo Hao Hụt";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-box-seam text-danger me-2"></i>Kho Quầy Bar & Báo Hao Hụt</h3>
            <p class="text-muted mb-0">Theo dõi tồn kho, cảnh báo tối thiểu và ghi nhận hao hụt trong ca</p>
        </div>
        <a class="btn btn-outline-dark" asp-controller="Barista" asp-action="KDS">
            <i class="bi bi-cup-hot me-1"></i> Quay lại KDS
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary-subtle text-primary p-3"><i class="bi bi-list-check fs-4"></i></div>
                    <div>
                        <div class="text-muted small">Tổng loại nguyên liệu</div>
                        <div class="fs-4 fw-bold">@Model.Summary.TotalIngredientTypes</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning-subtle text-warning p-3"><i class="bi bi-exclamation-triangle fs-4"></i></div>
                    <div>
                        <div class="text-muted small">Cảnh báo sắp hết</div>
                        <div class="fs-4 fw-bold">@Model.Summary.LowStockCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-danger-subtle text-danger p-3"><i class="bi bi-trash fs-4"></i></div>
                    <div>
                        <div class="text-muted small">Số lượt hao hụt hôm nay</div>
                        <div class="fs-4 fw-bold">@Model.Summary.TodayWastageCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold"><i class="bi bi-clipboard-x me-2 text-danger"></i>Báo cáo Hao hụt / Đổ hỏng</div>
                <div class="card-body">
                    <form asp-controller="Barista" asp-action="ReportWastage" method="post" onsubmit="return confirm('Xác nhận ghi nhận hao hụt và trừ tồn kho?');">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Nguyên liệu</label>
                            <select asp-for="ReportForm.IngredientId" class="form-select" required>
                                <option value="">-- Chọn nguyên liệu --</option>
                                @foreach (var ing in Model.Ingredients)
                                {
                                    <option value="@ing.IngredientId">@ing.IngredientName (@ing.Unit) - Tồn: @ing.StockQuantity.ToString("0.00")</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số lượng hao hụt</label>
                            <input asp-for="ReportForm.WastedQuantity" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Lý do</label>
                            <select asp-for="ReportForm.Reason" class="form-select" required>
                                <option value="">-- Chọn lý do --</option>
                                <option value="Pha nhầm">Pha nhầm</option>
                                <option value="Đánh đổ nguyên liệu">Đánh đổ nguyên liệu</option>
                                <option value="Quá hạn trong ca">Quá hạn trong ca</option>
                                <option value="Lỗi máy pha">Lỗi máy pha</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ghi chú riêng (tuỳ chọn)</label>
                            <textarea asp-for="ReportForm.Note" class="form-control" rows="2"></textarea>
                        </div>
                        <button class="btn btn-danger w-100"><i class="bi bi-send me-1"></i>Ghi nhận hao hụt</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white fw-bold"><i class="bi bi-boxes me-2 text-primary"></i>Tra cứu Tồn kho Nguyên liệu tại Quầy Bar</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã</th>
                                    <th>Tên nguyên liệu</th>
                                    <th>Đơn vị</th>
                                    <th>Tồn kho</th>
                                    <th>Mức tối thiểu</th>
                                    <th>Trạng thái</th>
                                    <th>Cập nhật cuối</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ing in Model.Ingredients)
                                {
                                    <tr class="@(ing.IsLowStock ? "table-warning" : "")">
                                        <td>@ing.IngredientId</td>
                                        <td class="fw-semibold">@ing.IngredientName</td>
                                        <td>@ing.Unit</td>
                                        <td>@ing.StockQuantity.ToString("0.00")</td>
                                        <td>@ing.MinStockLevel.ToString("0.00")</td>
                                        <td>
                                            @if (ing.IsLowStock)
                                            {
                                                <span class="badge bg-danger">Sắp hết</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Ổn định</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@ing.LastUpdated.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-bold"><i class="bi bi-clock-history me-2 text-secondary"></i>Lịch sử biến động & hao hụt hôm nay</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Thời gian</th>
                                    <th>Loại giao dịch</th>
                                    <th>Nguyên liệu</th>
                                    <th>Số lượng thay đổi</th>
                                    <th>Người thực hiện</th>
                                    <th>Lý do/Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.TodayTransactions.Any())
                                {
                                    <tr><td colspan="6" class="text-center text-muted py-3">Chưa có giao dịch nào hôm nay</td></tr>
                                }
                                else
                                {
                                    @foreach (var t in Model.TodayTransactions)
                                    {
                                        <tr>
                                            <td class="small">@t.Time.ToString("HH:mm:ss")</td>
                                            <td>
                                                @if (t.TransactionType == "Wastage")
                                                {
                                                    <span class="badge bg-danger">Wastage</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info text-dark">OrderDeduction</span>
                                                }
                                            </td>
                                            <td>@t.IngredientName</td>
                                            <td class="text-danger fw-semibold">@t.QuantityChanged.ToString("0.00")</td>
                                            <td>@t.PerformedByName</td>
                                            <td class="small">@t.ReasonOrNote</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
