@model CafeManagementSystem.Models.Entities.Order
@{
    ViewData["Title"] = "Cổng Thanh Toán Trực Tuyến";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden"
                 style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                
                <div class="p-4 text-center border-bottom text-white" style="background-color: var(--sidebar-bg);">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2"
                         style="width: 48px; height: 48px; background-color: rgba(255,255,255,0.12);">
                        <i class="bi bi-qr-code-scan fs-4" style="color: #FFE082;"></i>
                    </div>
                    <h5 class="fw-bold mb-1">CỔNG THANH TOÁN MÔ PHỎNG</h5>
                    <p class="small text-white-50 mb-0">Hệ thống chấp nhận VietQR / Chuyển khoản ngân hàng 24/7</p>
                </div>

                <div class="card-body p-4 text-center">
                    <p class="text-muted small mb-1">Mã đơn hàng: <strong class="text-dark">#@Model.OrderCode</strong></p>
                    <h2 class="fw-bold mb-3" style="color: var(--primary-green);">@Model.TotalAmount.ToString("N0") VNĐ</h2>

                    <!-- Mã QR giả lập thanh toán -->
                    <div class="p-3 rounded-4 d-inline-block shadow-xs mb-3" style="background-color: #FAF7F2; border: 1px solid var(--border-color);">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://cafecms.vn/pay/@Model.OrderCode" 
                             alt="QR Code" class="img-fluid rounded-3" style="width: 180px; height: 180px;" />
                        <div class="small text-muted mt-2" style="font-size: 0.78rem;">
                            <i class="bi bi-camera me-1"></i> Quét mã QR qua App Ngân Hàng
                        </div>
                    </div>

                    <div class="p-3 rounded-3 text-start mb-4" style="background-color: #FAF7F2; border: 1px solid var(--border-subtle); font-size: 0.88rem;">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Ngân hàng:</span>
                            <span class="fw-bold text-dark">MB Bank</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Số tài khoản:</span>
                            <span class="fw-bold font-monospace" style="color: var(--primary-green);">888899990000</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Chủ tài khoản:</span>
                            <span class="fw-bold text-dark">CONG TY CAFE CMS VN</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Nội dung chuyển khoản:</span>
                            <span class="fw-bold font-monospace" style="color: var(--accent-caramel);">PAY @Model.OrderCode</span>
                        </div>
                    </div>

                    <form asp-controller="PaymentGateway" asp-action="ConfirmPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <button type="submit" class="btn btn-cafe-primary btn-lg w-100 rounded-pill fw-bold shadow-sm mb-2">
                            <i class="bi bi-check-circle me-1"></i> Tôi Đã Chuyển Khoản Thành Công
                        </button>
                    </form>

                    <a asp-controller="Customer" asp-action="Bill" asp-route-id="@Model.OrderId" class="btn btn-cafe-outline w-100 rounded-pill btn-sm">
                        Xem hóa đơn tạm
                    </a>
                </div>

                <div class="card-footer border-top text-center small text-muted py-2" style="background-color: #FAF7F2; border-color: var(--border-subtle) !important;">
                    <i class="bi bi-shield-lock me-1 text-success"></i> Giao dịch bảo mật bởi Sandbox Payment Simulator
                </div>
            </div>
        </div>
    </div>
</div>
