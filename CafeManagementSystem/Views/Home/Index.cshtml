@{
    ViewData["Title"] = "Trang Chủ";
}

<div class="cafe-hero-section py-5">
    <div class="container-fluid px-lg-5">
        <div class="row align-items-center g-5 py-4">
            <!-- Left Hero Content -->
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3 shadow-xs" 
                     style="background-color: var(--surface-card); border: 1px solid var(--border-color);">
                    <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: var(--primary-green);"></span>
                    <span class="small fw-semibold" style="color: var(--primary-green);">Hương vị cà phê Robusta rang mộc chuẩn gu</span>
                </div>
                
                <h1 class="display-4 fw-bold text-dark mb-3" style="letter-spacing: -1px; line-height: 1.15;">
                    Trải Nghiệm Đồ Uống Tươi Mới Từ <span style="color: var(--primary-green);">Laura Café</span>
                </h1>
                
                <p class="text-muted fs-5 mb-4" style="line-height: 1.6; max-width: 520px;">
                    Tuyển chọn hạt cà phê chất lượng cao, trà ủ lạnh thảo mộc và công thức pha chế độc bản. Đặt món tiện lợi, giao hàng tận nơi và tích lũy điểm thưởng mỗi ngày.
                </p>

                <div class="d-flex gap-3 flex-wrap align-items-center mb-5">
                    <a asp-controller="Customer" asp-action="Menu" class="btn btn-cafe-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm">
                        <i class="bi bi-cup-straw me-2"></i> Khám Phá Thực Đơn
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-cafe-outline btn-lg rounded-pill px-4 py-3 fw-semibold">
                        <i class="bi bi-person-circle me-1"></i> Đăng Nhập
                    </a>
                </div>

                <!-- 3 Pillars -->
                <div class="row g-3 pt-3 border-top" style="border-color: var(--border-color) !important;">
                    <div class="col-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-check2-circle fs-4" style="color: var(--primary-green);"></i>
                            <span class="small fw-bold text-dark">Rang mộc 100%</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-lightning-charge fs-4" style="color: var(--accent-caramel);"></i>
                            <span class="small fw-bold text-dark">Giao nhanh 15p</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-stars fs-4" style="color: #B76E00;"></i>
                            <span class="small fw-bold text-dark">Tích điểm đổi quà</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Hero Image / Drink Presentation -->
            <div class="col-lg-6">
                <div class="position-relative p-4 rounded-5" style="background-color: var(--surface-card); border: 1px solid var(--border-color); box-shadow: var(--shadow-lg);">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="pos-prod-img-wrap rounded-4 mb-2 shadow-xs" style="height: 190px;">
                                <img src="/images/products/cf-sua.jpg" alt="Cà phê sữa đá" class="pos-prod-img" />
                            </div>
                            <div class="p-2">
                                <h6 class="fw-bold text-dark mb-1">Cà Phê Sữa Đá</h6>
                                <span class="small fw-bold" style="color: var(--primary-green);">29.000 đ</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="pos-prod-img-wrap rounded-4 mb-2 shadow-xs" style="height: 190px;">
                                <img src="/images/products/tra-dao.jpg" alt="Trà đào cam sả" class="pos-prod-img" />
                            </div>
                            <div class="p-2">
                                <h6 class="fw-bold text-dark mb-1">Trà Đào Cam Sả</h6>
                                <span class="small fw-bold" style="color: var(--primary-green);">45.000 đ</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 p-3 rounded-4 d-flex justify-content-between align-items-center" style="background-color: var(--sidebar-bg); color: #fff;">
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 40px; height: 40px; background-color: rgba(255,255,255,0.15);">
                                <i class="bi bi-clock-history fs-5" style="color: #FFE082;"></i>
                            </span>
                            <div>
                                <span class="small d-block text-white-50">Mở cửa phục vụ</span>
                                <strong class="small">07:00 – 22:30 hàng ngày</strong>
                            </div>
                        </div>
                        <a asp-controller="Customer" asp-action="Menu" class="btn btn-sm rounded-pill px-3 fw-bold" style="background-color: #FFE082; color: #302A25;">
                            Đặt ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
