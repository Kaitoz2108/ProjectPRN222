@model CafeManagementSystem.Models.ViewModels.AdminProductsViewModel
@{
    ViewData["Title"] = "Quản Lý Thực Đơn & Công Thức";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-cup-straw text-danger me-2"></i>Quản Lý Thực Đơn & Định Lượng Công Thức (BOM)</h3>
            <p class="text-muted mb-0">Cấu hình danh mục, sản phẩm, kích cỡ giá bán và công thức trừ kho tự động</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-danger rounded-pill" data-bs-toggle="modal" data-bs-target="#modalAddCategory">
                <i class="bi bi-folder-plus me-1"></i>Thêm Danh Mục
            </button>
            <button class="btn btn-danger rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddProduct">
                <i class="bi bi-plus-circle me-1"></i>Thêm Món Mới
            </button>
        </div>
    </div>

    <!-- Lọc danh mục -->
    <div class="d-flex gap-2 mb-4 flex-wrap">
        <a asp-action="Products" class="btn @(Model.SelectedCategoryId == null ? "btn-danger" : "btn-outline-danger") rounded-pill px-3">
            Tất cả danh mục (@Model.Products.Count)
        </a>
        @foreach (var cat in Model.Categories)
        {
            <a asp-action="Products" asp-route-categoryId="@cat.CategoryId"
               class="btn @(Model.SelectedCategoryId == cat.CategoryId ? "btn-danger" : "btn-outline-danger") rounded-pill px-3">
                @cat.CategoryName
            </a>
        }
    </div>

    <!-- Danh sách sản phẩm -->
    <div class="row g-4">
        @foreach (var prod in Model.Products)
        {
            <div class="col-xl-6">
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden h-100">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-danger">@prod.Category.CategoryName</span>
                            <h5 class="fw-bold mb-0 text-dark">@prod.ProductName</h5>
                            <span class="badge @(prod.IsAvailable ? "bg-success" : "bg-secondary")">
                                @(prod.IsAvailable ? "Đang bán" : "Tạm ngừng")
                            </span>
                        </div>
                        <form asp-action="ToggleProductStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@prod.ProductId" />
                            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                            <button type="submit" class="btn btn-sm @(prod.IsAvailable ? "btn-outline-secondary" : "btn-outline-success") rounded-pill">
                                @(prod.IsAvailable ? "Ngừng bán" : "Bật bán")
                            </button>
                        </form>
                    </div>

                    <div class="card-body p-3">
                        <p class="text-muted small mb-3">@(prod.Description ?? "Chưa có mô tả.")</p>

                        <!-- Biến thể & Công thức -->
                        <div class="fw-bold small text-secondary mb-2 d-flex justify-content-between align-items-center">
                            <span>KÍCH CỠ & ĐỊNH LƯỢNG NGUYÊN LIỆU (RECIPES):</span>
                            <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none"
                                    data-bs-toggle="modal" data-bs-target="#modalAddVariant-@prod.ProductId">
                                <i class="bi bi-plus-circle me-1"></i>Thêm Size
                            </button>
                        </div>

                        <div class="d-flex flex-column gap-2">
                            @foreach (var v in prod.ProductVariants.OrderBy(v => v.Price))
                            {
                                <div class="bg-light p-3 rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <span class="badge bg-dark fs-6">Size @v.SizeName</span>
                                            <span class="fw-bold text-danger ms-2">@v.Price.ToString("N0") đ</span>
                                            @if (!v.IsActive)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">Đã khóa</span>
                                            }
                                        </div>
                                        <button class="btn btn-outline-primary btn-sm rounded-pill"
                                                data-bs-toggle="modal" data-bs-target="#modalAddRecipe-@v.VariantId">
                                            <i class="bi bi-plus me-1"></i>Thêm nguyên liệu
                                        </button>
                                    </div>

                                    @if (!v.ProductRecipes.Any())
                                    {
                                        <div class="text-warning small fst-italic">
                                            <i class="bi bi-exclamation-circle me-1"></i>Chưa thiết lập công thức (không trừ kho khi pha chế)
                                        </div>
                                    }
                                    else
                                    {
                                        <ul class="list-unstyled mb-0 small">
                                            @foreach (var r in v.ProductRecipes)
                                            {
                                                <li class="d-flex justify-content-between align-items-center py-1 border-bottom border-light">
                                                    <span>
                                                        <i class="bi bi-check2 text-success me-1"></i>
                                                        <strong>@r.Ingredient.IngredientName:</strong> @r.QuantityRequired.ToString("0.##") @r.Ingredient.Unit
                                                        @if (!string.IsNullOrWhiteSpace(r.PreparationGuide))
                                                        {
                                                            <span class="text-muted">(@r.PreparationGuide)</span>
                                                        }
                                                    </span>
                                                    <form asp-action="DeleteRecipe" method="post" class="d-inline" onsubmit="return confirm('Xóa nguyên liệu này khỏi công thức?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="recipeId" value="@r.RecipeId" />
                                                        <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                                        <button type="submit" class="btn btn-link text-danger p-0" title="Xóa">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>

                                <!-- Modal Thêm Nguyên Liệu cho Variant -->
                                <div class="modal fade" id="modalAddRecipe-@v.VariantId" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content rounded-4">
                                            <div class="modal-header bg-primary text-white">
                                                <h5 class="modal-title fw-bold">Công Thức Cho @prod.ProductName (Size @v.SizeName)</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="SaveRecipe" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="VariantId" value="@v.VariantId" />
                                                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Chọn nguyên liệu:</label>
                                                        <select name="IngredientId" class="form-select" required>
                                                            @foreach (var ing in Model.Ingredients)
                                                            {
                                                                <option value="@ing.IngredientId">@ing.IngredientName (@ing.Unit) - Tồn: @ing.StockQuantity</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Định lượng cần dùng cho 1 ly:</label>
                                                        <input type="number" step="0.01" name="QuantityRequired" class="form-control" placeholder="Ví dụ: 18 (gram) hoặc 40 (ml)" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Hướng dẫn pha chế (tuỳ chọn):</label>
                                                        <input type="text" name="PreparationGuide" class="form-control" placeholder="Ví dụ: Đong vào đáy ly, khuấy đều..." />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Đóng</button>
                                                    <button type="submit" class="btn btn-primary rounded-pill">Lưu công thức</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Modal Thêm Variant cho Product -->
                <div class="modal fade" id="modalAddVariant-@prod.ProductId" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content rounded-4">
                            <div class="modal-header bg-dark text-white">
                                <h5 class="modal-title fw-bold">Thêm Kích Cỡ Cho @prod.ProductName</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-action="SaveVariant" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ProductId" value="@prod.ProductId" />
                                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Tên kích cỡ:</label>
                                        <input type="text" name="SizeName" class="form-control" placeholder="S, M, L, XL..." required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Giá bán (VNĐ):</label>
                                        <input type="number" step="1000" name="Price" class="form-control" placeholder="Ví dụ: 35000" required />
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Đóng</button>
                                    <button type="submit" class="btn btn-danger rounded-pill">Lưu kích cỡ</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Tạo Sản Phẩm Mới -->
<div class="modal fade" id="modalAddProduct" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i>Thêm Món Mới Vào Thực Đơn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateProduct" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Thuộc danh mục:</label>
                        <select name="CategoryId" class="form-select" required>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.CategoryId" selected="@(Model.SelectedCategoryId == c.CategoryId)">@c.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên sản phẩm / đồ uống:</label>
                        <input type="text" name="ProductName" class="form-control" placeholder="Ví dụ: Cà Phê Muối, Trà Sữa Oolong..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả sản phẩm:</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Hương vị, thành phần nổi bật..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Đường dẫn ảnh (tuỳ chọn):</label>
                        <input type="text" name="ImageUrl" class="form-control" placeholder="/images/products/cf-muoi.jpg" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill">Tạo món mới</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Tạo Danh Mục Mới -->
<div class="modal fade" id="modalAddCategory" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-folder-plus me-2"></i>Thêm Danh Mục Thực Đơn Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên danh mục:</label>
                        <input type="text" name="CategoryName" class="form-control" placeholder="Ví dụ: Cà phê Đặc sản, Trà Sữa..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả:</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Mô tả về nhóm đồ uống này"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill">Lưu danh mục</button>
                </div>
            </form>
        </div>
    </div>
</div>

