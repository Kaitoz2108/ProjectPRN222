@model AdminComplaintsViewModel
@{ 
    ViewData["Title"] = "Khiếu Nại & Phê Duyệt Hoàn Tiền"; 
}

<div class="container-fluid px-3 px-lg-4 py-3">
    <!-- Header Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 pb-2 border-bottom" style="border-color: var(--border-color) !important;">
        <div>
            <h2 class="fw-bold text-dark mb-1">Xử lý khiếu nại & Hoàn tiền</h2>
            <p class="text-muted small mb-0">Tiếp nhận phản hồi từ khách hàng, điều tra sự cố và phê duyệt hoàn tiền mô phỏng (RefundGateway)</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Dashboard" class="btn btn-cafe-outline rounded-pill btn-sm d-inline-flex align-items-center gap-1">
                <i class="bi bi-bar-chart-line"></i> Dashboard
            </a>
            <a asp-action="StaffSchedule" class="btn btn-cafe-outline rounded-pill btn-sm d-inline-flex align-items-center gap-1">
                <i class="bi bi-people"></i> Nhân sự & Phân ca
            </a>
        </div>
    </div>

    <div asp-validation-summary="All" class="alert alert-danger py-2 rounded-3 small" role="alert"></div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="small fw-semibold text-muted">
            Tổng cộng: <strong class="text-dark">@Model.Complaints.Count</strong> phản hồi từ khách hàng
        </span>
        <span class="small text-muted">
            <i class="bi bi-info-circle me-1"></i>Hoàn tiền chỉ được duyệt tối đa giá trị đơn đã thanh toán.
        </span>
    </div>

    @if (Model.Complaints.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5" 
             style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
            <div class="card-body py-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                     style="width: 72px; height: 72px; background-color: var(--primary-green-light); color: var(--primary-green);">
                    <i class="bi bi-chat-heart fs-2"></i>
                </div>
                <h4 class="fw-bold text-dark">Chưa có khiếu nại hoặc phản hồi nào</h4>
                <p class="text-muted small mb-0">Hệ thống ghi nhận sự hài lòng cao từ phía khách hàng.</p>
            </div>
        </div>
    }

    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model.Complaints)
        {
            var edit = Model.Resolution.ComplaintId == item.ComplaintId ? Model.Resolution : new AdminResolveComplaintInput { ComplaintId = item.ComplaintId };
            
            string badgeClass = item.ComplaintStatus switch
            {
                "Pending" => "cafe-badge-warning",
                "InProgress" => "cafe-badge",
                "Resolved" => "cafe-badge-success",
                "Rejected" => "cafe-badge-danger",
                _ => "cafe-badge-neutral"
            };

            string statusText = item.ComplaintStatus switch
            {
                "Pending" => "Chờ xử lý",
                "InProgress" => "Đang kiểm tra",
                "Resolved" => "Đã giải quyết",
                "Rejected" => "Từ chối",
                _ => item.ComplaintStatus
            };

            var canResolve = !item.IsRefundApproved && (item.ComplaintStatus == "Pending" || item.ComplaintStatus == "InProgress");

            <article class="card border-0 shadow-sm rounded-4 overflow-hidden" 
                     style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                
                <!-- Card Header -->
                <div class="card-header border-bottom p-3 d-flex justify-content-between align-items-center flex-wrap gap-2"
                     style="background-color: #FAF7F2; border-color: var(--border-color) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-dark fs-6">#@item.ComplaintId</span>
                        <span class="badge rounded-pill bg-light text-dark border">Đơn #@item.Order.OrderCode</span>
                        <span class="badge rounded-pill bg-light text-muted border">@item.ComplaintType</span>
                    </div>
                    <span class="@badgeClass">@statusText</span>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4">
                        <!-- Left: Customer Feedback Content -->
                        <div class="col-lg-6 border-end-lg" style="border-color: var(--border-light) !important;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <strong class="text-dark">@item.Customer.FullName</strong>
                                    <span class="text-muted small ms-2">(@item.Customer.Phone)</span>
                                </div>
                                <small class="text-muted" style="font-size: 0.8rem;">
                                    <i class="bi bi-clock me-1"></i>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            <!-- Rating stars -->
                            <div class="mb-2">
                                <span class="small fw-semibold text-muted">Đánh giá:</span>
                                <span class="text-warning ms-1">
                                    @for (int s = 0; s < (item.Rating ?? 5); s++) { <span>★</span> }
                                </span>
                                <span class="small text-muted ms-1">(@(item.Rating.HasValue ? $"{item.Rating}/5 sao" : "Không xếp hạng"))</span>
                            </div>

                            <!-- Content -->
                            <div class="p-3 rounded-3 mb-3 text-dark small" style="background-color: #FAF7F2; border: 1px solid var(--border-subtle); white-space: pre-wrap;">@item.Content</div>

                            <!-- Evidence Image -->
                            @if (!string.IsNullOrWhiteSpace(item.EvidenceImageUrl))
                            {
                                var safeEvidence = Url.IsLocalUrl(item.EvidenceImageUrl) || (Uri.TryCreate(item.EvidenceImageUrl, UriKind.Absolute, out var uri) && (uri.Scheme == "https" || uri.Scheme == "http"));
                                if (safeEvidence)
                                {
                                    <div class="mb-2">
                                        <span class="small fw-bold text-dark d-block mb-1">Ảnh minh chứng:</span>
                                        <a href="@Url.Content(item.EvidenceImageUrl)" target="_blank" rel="noopener noreferrer">
                                            <img src="@Url.Content(item.EvidenceImageUrl)" alt="Ảnh minh chứng" class="img-thumbnail rounded-3" style="max-height: 160px; max-width: 100%;" loading="lazy" />
                                        </a>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Right: Admin Resolution & Refund Control -->
                        <div class="col-lg-6">
                            @if (canResolve)
                            {
                                <form asp-action="ResolveComplaint" method="post" class="row g-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Resolution.ComplaintId" value="@item.ComplaintId" />

                                    <div class="col-12">
                                        <label for="response-@item.ComplaintId" class="form-label small fw-bold text-dark">
                                            Phản hồi giải quyết cho khách hàng <span class="text-danger">*</span>
                                        </label>
                                        <textarea id="response-@item.ComplaintId" name="Resolution.AdminResponse" class="form-control form-control-sm" rows="3" maxlength="1000" placeholder="Nhập lời xin lỗi, giải thích hoặc hướng khắc phục..." required>@edit.AdminResponse</textarea>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="result-@item.ComplaintId" class="form-label small fw-bold text-dark">Kết quả xử lý</label>
                                        <select id="result-@item.ComplaintId" name="Resolution.Status" class="form-select form-select-sm">
                                            <option value="Resolved" selected="@(edit.Status == "Resolved")">Resolved — Đã giải quyết</option>
                                            <option value="Rejected" selected="@(edit.Status == "Rejected")">Rejected — Từ chối khiếu nại</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="amount-@item.ComplaintId" class="form-label small fw-bold text-dark">Số tiền hoàn (VNĐ)</label>
                                        <input id="amount-@item.ComplaintId" name="Resolution.RefundAmount" type="number" min="0" max="@item.Order.TotalAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" value="@edit.RefundAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" required />
                                    </div>

                                    <div class="col-12">
                                        <div class="p-2 rounded border" style="background-color: #FFF9F0; border-color: #FFE0B2 !important;">
                                            <div class="form-check">
                                                <input id="refund-@item.ComplaintId" type="checkbox" name="Resolution.IsRefundApproved" value="true" checked="@edit.IsRefundApproved" class="form-check-input" />
                                                <label for="refund-@item.ComplaintId" class="form-check-label small fw-bold text-dark">
                                                    Phê duyệt hoàn tiền (Approve Refund vào ví khách hàng)
                                                </label>
                                            </div>
                                            <input type="hidden" name="Resolution.IsRefundApproved" value="false" />
                                        </div>
                                    </div>

                                    <div class="col-12 mt-2">
                                        <button class="btn btn-cafe-primary rounded-pill px-4 fw-bold">
                                            <i class="bi bi-check2-circle me-1"></i> Lưu Xử Lý Khiếu Nại #@item.ComplaintId
                                        </button>
                                        <p class="text-muted mt-1 mb-0" style="font-size: 0.75rem;">Sau khi lưu, kết quả xử lý được khóa để đảm bảo an toàn giao dịch.</p>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="p-3 rounded-3" style="background-color: #FAF7F2; border: 1px solid var(--border-subtle);">
                                    <h6 class="fw-bold text-dark mb-1" style="font-size: 0.9rem;">
                                        <i class="bi bi-shield-check me-1" style="color: var(--primary-green);"></i>Phản hồi của Ban Quản Trị
                                    </h6>
                                    <p class="small text-dark mb-2" style="white-space: pre-wrap;">@(item.AdminResponse ?? "Chưa có phản hồi.")</p>
                                    
                                    <div class="d-flex justify-content-between align-items-center small text-muted pt-2 border-top" style="border-color: var(--border-light) !important; font-size: 0.78rem;">
                                        <span>Người duyệt: <strong>@(item.ResolvedByAdmin?.FullName ?? "—")</strong></span>
                                        <span>@(item.ResolvedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                                    </div>

                                    <div class="mt-2">
                                        @if (item.IsRefundApproved)
                                        {
                                            <span class="cafe-badge cafe-badge-success">
                                                <i class="bi bi-cash-coin me-1"></i>Đã phê duyệt hoàn tiền: @item.RefundAmount?.ToString("N0") VNĐ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="cafe-badge cafe-badge-neutral">
                                                <i class="bi bi-x-circle me-1"></i>Không phê duyệt hoàn tiền
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
</div>
