@model List<CafeManagementSystem.Models.Entities.Ingredient>
@using CafeManagementSystem.Models.Entities
@{
    ViewData["Title"] = "Quản lý kho";
    var ingredients = ViewBag.Ingredients as List<Ingredient> ?? Model;
    var transactions = ViewBag.Transactions as List<InventoryTransaction> ?? new List<InventoryTransaction>();
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-box-seam text-success me-2"></i>Quản lý kho nguyên liệu</h1>
            <p class="text-muted mb-0">Theo dõi tồn kho, nhập hàng và lịch sử biến động</p>
        </div>
        <a asp-action="Products" class="btn btn-outline-primary"><i class="bi bi-cup-hot me-1"></i>Quản lý thực đơn</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold"><i class="bi bi-plus-circle me-1"></i>Thêm nguyên liệu</div>
                <div class="card-body">
                    <form asp-action="CreateIngredient" method="post">
                        <div class="mb-3">
                            <label class="form-label" for="ingredientName">Tên nguyên liệu</label>
                            <input class="form-control" id="ingredientName" name="ingredientName" maxlength="150" required />
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="unit">Đơn vị</label>
                                <input class="form-control" id="unit" name="unit" maxlength="30" placeholder="ml, gram, kg..." required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="minStockLevel">Mức tồn tối thiểu</label>
                                <input class="form-control" id="minStockLevel" name="minStockLevel" type="number" min="0" step="0.01" required />
                            </div>
                        </div>
                        <button class="btn btn-success" type="submit">Thêm nguyên liệu</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold"><i class="bi bi-cart-plus me-1"></i>Nhập hàng / Restock</div>
                <div class="card-body">
                    @if (ingredients.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">Hãy thêm nguyên liệu trước khi nhập hàng.</div>
                    }
                    else
                    {
                        <form asp-action="Restock" method="post">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="restockIngredientId">Nguyên liệu</label>
                                    <select class="form-select" id="restockIngredientId" name="ingredientId" required>
                                        <option value="">-- Chọn nguyên liệu --</option>
                                        @foreach (var ingredient in ingredients)
                                        {
                                            <option value="@ingredient.IngredientId">@ingredient.IngredientName (@ingredient.Unit)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="quantityAdded">Số lượng nhập</label>
                                    <input class="form-control" id="quantityAdded" name="quantityAdded" type="number" min="0.01" step="0.01" required />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="unitCost">Đơn giá vốn</label>
                                    <div class="input-group">
                                        <input class="form-control" id="unitCost" name="unitCost" type="number" min="0" step="0.01" required />
                                        <span class="input-group-text">đ</span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="reasonOrNote">Ghi chú nhà cung cấp</label>
                                    <input class="form-control" id="reasonOrNote" name="reasonOrNote" maxlength="300" placeholder="Nhà cung cấp, số hóa đơn..." />
                                </div>
                            </div>
                            <button class="btn btn-primary mt-3" type="submit">Ghi nhận nhập kho</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <section class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold"><i class="bi bi-bar-chart-line me-1"></i>Thông tin tồn kho</span>
            <span class="badge bg-danger">@Model.Count(item => item.StockQuantity <= item.MinStockLevel) cảnh báo</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nguyên liệu</th>
                            <th>Đơn vị</th>
                            <th class="text-end">Tồn hiện tại</th>
                            <th class="text-end">Mức tối thiểu</th>
                            <th>Cập nhật lần cuối</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ingredient in Model)
                        {
                            var isLowStock = ingredient.StockQuantity <= ingredient.MinStockLevel;
                            <tr class="@(isLowStock ? "table-danger" : "")">
                                <td class="fw-semibold">@ingredient.IngredientName</td>
                                <td>@ingredient.Unit</td>
                                <td class="text-end fw-bold">@ingredient.StockQuantity.ToString("N2")</td>
                                <td class="text-end">@ingredient.MinStockLevel.ToString("N2")</td>
                                <td>@ingredient.LastUpdated.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (isLowStock)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>Tồn thấp</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Đủ tồn</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (Model.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">Chưa có nguyên liệu.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold"><i class="bi bi-clock-history me-1"></i>Lịch sử giao dịch kho</span>
            <span class="text-muted small">Tối đa 200 giao dịch gần nhất</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Thời gian</th>
                            <th>Nguyên liệu</th>
                            <th>Loại giao dịch</th>
                            <th class="text-end">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th>Người thực hiện</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in transactions)
                        {
                            var transactionClass = transaction.TransactionType switch
                            {
                                "Restock" => "text-success",
                                "Wastage" => "text-danger",
                                "OrderDeduction" => "text-warning",
                                _ => "text-secondary"
                            };
                            <tr>
                                <td>@transaction.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@transaction.Ingredient?.IngredientName</td>
                                <td><span class="fw-semibold @transactionClass">@transaction.TransactionType</span></td>
                                <td class="text-end @(transaction.QuantityChanged < 0 ? "text-danger" : "text-success")">@(transaction.QuantityChanged > 0 ? "+" : "")@transaction.QuantityChanged.ToString("N2")</td>
                                <td class="text-end">@(transaction.UnitCost?.ToString("N0") ?? "-")</td>
                                <td>@transaction.PerformedByUser?.FullName</td>
                                <td>@(transaction.ReasonOrNote ?? "-")</td>
                            </tr>
                        }
                        @if (transactions.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">Chưa có giao dịch kho.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
