@model List<CafeManagementSystem.Models.Entities.Product>
@{
    ViewData["Title"] = "Thực đơn hôm nay";
    var categories = ViewBag.Categories as List<CafeManagementSystem.Models.Entities.Category> ?? new();
    int? selectedCat = ViewBag.SelectedCategoryId as int?;
    int cartCount = ViewBag.CartCount as int? ?? 0;
    int userPoints = ViewBag.UserPoints as int? ?? 0;
    string userName = ViewBag.UserName as string ?? "Khách hàng";
}

<div class="cafe-menu-page py-4">
    <div class="container" style="max-width: 1180px;">
        
        <!-- Header Banner: "Thực đơn hôm nay" + Member Points Badge (Photo 1) -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="h2 fw-bold text-dark mb-1">Thực đơn hôm nay</h1>
                <p class="text-muted mb-0" style="font-size: 0.95rem;">
                    Thưởng thức cà phê Robusta rang mộc & trà thảo mộc tươi mới pha chế trực tiếp
                </p>
            </div>

            <!-- Member Loyalty Card Pill -->
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm"
                         style="background-color: var(--surface-card); border: 1px solid var(--border-color);">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                              style="width: 28px; height: 28px; background: #FFF4E5; color: var(--accent-caramel);">
                            <i class="bi bi-stars"></i>
                        </span>
                        <div>
                            <span class="small text-muted d-block" style="font-size: 0.75rem; line-height: 1;">Điểm tích lũy</span>
                            <span class="fw-bold" style="color: var(--accent-caramel);">@userPoints.ToString("N0") điểm</span>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-cafe-outline d-inline-flex align-items-center gap-1 shadow-sm">
                        <i class="bi bi-person-circle"></i> Đăng nhập tích điểm
                    </a>
                }
            </div>
        </div>

        <!-- Filter & Search Toolbar (Photo 1) -->
        <div class="card border-0 shadow-sm rounded-4 mb-4" style="background-color: var(--surface-card);">
            <div class="card-body p-3">
                <div class="row g-3 align-items-center">
                    <!-- Live Search Box -->
                    <div class="col-12 col-md-5 col-lg-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: var(--radius-pill) 0 0 var(--radius-pill);">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="menuSearchInput" class="form-control border-start-0" 
                                   placeholder="Tìm kiếm đồ uống..." 
                                   style="border-radius: 0 var(--radius-pill) var(--radius-pill) 0;" />
                        </div>
                    </div>

                    <!-- Category Pills Horizontal Scroll -->
                    <div class="col-12 col-md-7 col-lg-8">
                        <div class="d-flex gap-2 overflow-auto pb-1 flex-nowrap align-items-center">
                            <a asp-action="Menu" 
                               class="btn text-nowrap rounded-pill px-3 py-2 fw-semibold @(selectedCat == null ? "btn-cafe-primary" : "btn-cafe-secondary")">
                                Tất cả
                            </a>
                            @foreach (var cat in categories)
                            {
                                <a asp-action="Menu" asp-route-categoryId="@cat.CategoryId"
                                   class="btn text-nowrap rounded-pill px-3 py-2 fw-semibold @(selectedCat == cat.CategoryId ? "btn-cafe-primary" : "btn-cafe-secondary")">
                                    @cat.CategoryName
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Cards Grid (Photo 1) -->
        <div class="row g-4" id="productListGrid">
            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <div class="py-5">
                        <i class="bi bi-cup-hot fs-1 text-muted opacity-50 d-block mb-3"></i>
                        <h5 class="fw-bold text-dark">Hiện chưa có sản phẩm nào</h5>
                        <p class="text-muted">Vui lòng quay lại sau hoặc chọn danh mục khác.</p>
                        <a asp-action="Menu" class="btn btn-cafe-primary rounded-pill px-4 mt-2">Xem tất cả đồ uống</a>
                    </div>
                </div>
            }
            else
            {
                @foreach (var prod in Model)
                {
                    var activeVariants = prod.ProductVariants.Where(v => v.IsActive).OrderBy(v => v.Price).ToList();
                    var minPrice = activeVariants.Any() ? activeVariants.Min(v => v.Price) : 0;
                    var maxPrice = activeVariants.Any() ? activeVariants.Max(v => v.Price) : 0;

                    // Lấy ảnh trực tiếp từ database
                    var imgUrl = !string.IsNullOrWhiteSpace(prod.ImageUrl) 
                        ? prod.ImageUrl 
                        : "/images/products/default.jpg";

                    var variantsJson = System.Text.Json.JsonSerializer.Serialize(activeVariants.Select(v => new {
                        variantId = v.VariantId,
                        sizeName = v.SizeName,
                        price = v.Price
                    }));

                    <div class="col-12 col-md-6 col-lg-4 product-card-col" data-product-name="@prod.ProductName.ToLower()">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative product-card-hover"
                             style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                            
                            <!-- Large Drink Image (Photo 1) -->
                            <div class="cafe-product-img-wrap">
                                <img src="@imgUrl" alt="@prod.ProductName" 
                                     class="cafe-product-img"
                                     onerror="this.onerror=null; this.src='/images/products/default.jpg';" />
                                <span class="position-absolute top-0 end-0 m-3 badge rounded-pill px-3 py-2 fw-semibold"
                                      style="background: rgba(255, 255, 255, 0.92); color: var(--text-main); backdrop-filter: blur(4px); box-shadow: 0 2px 6px rgba(0,0,0,0.08);">
                                    @prod.Category.CategoryName
                                </span>
                            </div>

                            <!-- Card Body -->
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">@prod.ProductName</h5>
                                    <p class="text-muted small mb-3 text-truncate-2" style="min-height: 40px; color: var(--text-muted) !important;">
                                        @(string.IsNullOrWhiteSpace(prod.Description) ? "Thức uống chất lượng cao được tinh chế từ nguyên liệu tươi tuyển chọn." : prod.Description)
                                    </p>
                                </div>

                                <div class="d-flex align-items-center justify-content-between pt-2 border-top" style="border-color: var(--border-subtle) !important;">
                                    <div>
                                        <span class="text-muted d-block small" style="font-size: 0.78rem;">Giá từ</span>
                                        <span class="fw-bold fs-5" style="color: var(--primary-green);">
                                            @minPrice.ToString("N0") <span style="font-size: 0.85rem;">đ</span>
                                        </span>
                                    </div>
                                    <button type="button" 
                                            class="btn btn-cafe-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 btn-open-customizer"
                                            data-product-id="@prod.ProductId"
                                            data-product-name="@prod.ProductName"
                                            data-product-desc="@(prod.Description ?? "")"
                                            data-product-image="@imgUrl"
                                            data-product-category="@prod.Category.CategoryName"
                                            data-variants='@variantsJson'>
                                        <span>Chọn món</span>
                                        <i class="bi bi-arrow-right-short fs-5"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL CHỌN MÓN (Photo 1 Reference)
     Chọn Size, Đường, Đá, Số lượng, Ghi chú
     ========================================================================= -->
<div class="modal fade" id="modalCustomDrink" tabindex="-1" aria-labelledby="modalDrinkTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background-color: var(--surface-card);">
            
            <form asp-controller="Customer" asp-action="AddToCart" method="post" id="formAddToCart">
                @Html.AntiForgeryToken()
                
                <div class="modal-body p-0">
                    <div class="row g-0">
                        <!-- Left column: Product Image -->
                        <div class="col-12 col-md-5 position-relative cafe-modal-img-wrap">
                            <img id="modalDrinkImg" src="/images/products/default.jpg" alt="Đồ uống" 
                                 class="cafe-product-img" />
                            <span id="modalDrinkCategory" class="position-absolute top-0 start-0 m-3 badge rounded-pill px-3 py-2 fw-semibold"
                                  style="background: rgba(255, 255, 255, 0.9); color: var(--text-main);">
                                Cà phê
                            </span>
                            <button type="button" class="btn-close position-absolute top-0 end-0 m-3 d-md-none bg-white p-2 rounded-circle shadow-sm" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <!-- Right column: Customization Options -->
                        <div class="col-12 col-md-7 p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h4 class="fw-bold text-dark mb-1" id="modalDrinkTitle">Tên đồ uống</h4>
                                    <p class="text-muted small mb-0" id="modalDrinkDesc">Mô tả sản phẩm</p>
                                </div>
                                <button type="button" class="btn-close d-none d-md-block" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <hr style="border-color: var(--border-color); margin: 12px 0;" />

                            <!-- 1. Chọn Kích cỡ (Size) -->
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-dark d-block mb-2">
                                    <i class="bi bi-cup me-1 text-success"></i> Chọn Kích cỡ (Size) <span class="text-danger">*</span>
                                </label>
                                <div class="d-flex gap-2 flex-wrap" id="modalSizeContainer">
                                    <!-- Populated dynamically via JS -->
                                </div>
                            </div>

                            <!-- 2. Chọn Mức đường -->
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-dark d-block mb-2">
                                    <i class="bi bi-droplet-half me-1 text-warning"></i> Chọn Mức Đường
                                </label>
                                <div class="d-flex gap-2 flex-wrap">
                                    <label class="btn-cafe-option flex-fill text-center">
                                        <input type="radio" name="sugarLevel" value="100%" checked />
                                        <span>100% đường</span>
                                    </label>
                                    <label class="btn-cafe-option flex-fill text-center">
                                        <input type="radio" name="sugarLevel" value="70%" />
                                        <span>70% đường</span>
                                    </label>
                                    <label class="btn-cafe-option flex-fill text-center">
                                        <input type="radio" name="sugarLevel" value="50%" />
                                        <span>50% đường</span>
                                    </label>
                                    <label class="btn-cafe-option flex-fill text-center">
                                        <input type="radio" name="sugarLevel" value="0%" />
                                        <span>0% đường</span>
                                    </label>
                                </div>
                            </div>

                            <!-- 3. Chọn Mức đá -->
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-dark d-block mb-2">
                                    <i class="bi bi-snow me-1 text-info"></i> Chọn Mức Đá
                                </label>
                                <div class="d-flex gap-2 flex-wrap">
                                    <label class="btn-cafe-option flex-fill text-center">
                                        <input type="radio" name="iceLevel" value="100%" checked />
                                        <span>100% đá</span>
                                    </label>
                                    <label class="btn-cafe-option flex-fill text-center">
                                        <input type="radio" name="iceLevel" value="70%" />
                                        <span>70% đá</span>
                                    </label>
                                    <label class="btn-cafe-option flex-fill text-center">
                                        <input type="radio" name="iceLevel" value="50%" />
                                        <span>50% đá</span>
                                    </label>
                                    <label class="btn-cafe-option flex-fill text-center">
                                        <input type="radio" name="iceLevel" value="0%" />
                                        <span>Không đá</span>
                                    </label>
                                </div>
                            </div>

                            <!-- 4. Ghi chú đặc biệt -->
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-dark mb-1">Ghi chú cho Barista</label>
                                <input type="text" name="itemNote" class="form-control" 
                                       placeholder="VD: Nhiều sữa đặc, tách riêng đá..." />
                            </div>

                            <!-- 5. Số lượng & Nút Thêm vào giỏ -->
                            <div class="d-flex align-items-center gap-3 pt-3 border-top" style="border-color: var(--border-color) !important;">
                                <!-- Stepper -->
                                <div class="d-flex align-items-center border rounded-pill bg-white px-2 py-1 shadow-sm" style="border-color: var(--border-color) !important;">
                                    <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none px-2" id="btnMinusQty">
                                        <i class="bi bi-dash fs-5"></i>
                                    </button>
                                    <input type="number" name="quantity" id="inputQuantity" value="1" min="1" max="50" 
                                           class="form-control border-0 text-center fw-bold p-0" style="width: 40px; box-shadow: none;" readonly />
                                    <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none px-2" id="btnPlusQty">
                                        <i class="bi bi-plus fs-5"></i>
                                    </button>
                                </div>

                                <!-- Add to Cart Button -->
                                <button type="submit" class="btn btn-cafe-primary flex-grow-1 rounded-pill py-2 fw-bold d-flex justify-content-between align-items-center px-4">
                                    <span>Thêm vào giỏ hàng</span>
                                    <span id="modalTotalPrice">0 đ</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Mobile Sticky Bottom Cart Indicator (Photo 1) -->
@if (cartCount > 0)
{
    <div class="d-md-none position-fixed bottom-0 start-0 end-0 p-3 z-3" style="background: rgba(247, 244, 238, 0.95); backdrop-filter: blur(8px); border-top: 1px solid var(--border-color);">
        <a asp-action="Cart" class="btn btn-cafe-primary w-100 rounded-pill py-3 px-4 d-flex justify-content-between align-items-center shadow-lg text-decoration-none">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-bag-check-fill fs-5"></i>
                <span class="fw-bold">Giỏ hàng của bạn</span>
                <span class="badge bg-white text-dark rounded-pill">@cartCount món</span>
            </div>
            <span class="fw-bold">Xem giỏ hàng <i class="bi bi-chevron-right ms-1"></i></span>
        </a>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Live Search Filter
            const searchInput = document.getElementById('menuSearchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const query = this.value.trim().toLowerCase();
                    const productCols = document.querySelectorAll('.product-card-col');
                    productCols.forEach(col => {
                        const name = col.getAttribute('data-product-name') || '';
                        if (name.includes(query)) {
                            col.style.display = '';
                        } else {
                            col.style.display = 'none';
                        }
                    });
                });
            }

            // Modal Drink Customizer Logic
            const modalEl = document.getElementById('modalCustomDrink');
            const customModal = new bootstrap.Modal(modalEl);
            let currentVariants = [];
            let currentSelectedPrice = 0;

            const modalTitle = document.getElementById('modalDrinkTitle');
            const modalDesc = document.getElementById('modalDrinkDesc');
            const modalImg = document.getElementById('modalDrinkImg');
            const modalCategory = document.getElementById('modalDrinkCategory');
            const modalSizeContainer = document.getElementById('modalSizeContainer');
            const modalTotalPrice = document.getElementById('modalTotalPrice');
            const inputQty = document.getElementById('inputQuantity');

            function updatePriceDisplay() {
                const qty = parseInt(inputQty.value) || 1;
                const total = currentSelectedPrice * qty;
                modalTotalPrice.textContent = total.toLocaleString('vi-VN') + ' đ';
            }

            // Open customizer when clicking "Chọn món"
            document.querySelectorAll('.btn-open-customizer').forEach(btn => {
                btn.addEventListener('click', function () {
                    const name = this.getAttribute('data-product-name');
                    const desc = this.getAttribute('data-product-desc');
                    const img = this.getAttribute('data-product-image');
                    const cat = this.getAttribute('data-product-category');
                    const rawVariants = this.getAttribute('data-variants');

                    try {
                        currentVariants = JSON.parse(rawVariants) || [];
                    } catch (e) {
                        currentVariants = [];
                    }

                    modalTitle.textContent = name;
                    modalDesc.textContent = desc || 'Thức uống được pha chế trực tiếp từ quầy bar.';
                    modalImg.src = img || '/images/products/default.jpg';
                    modalCategory.textContent = cat || 'Đồ uống';
                    inputQty.value = 1;

                    // Render sizes
                    modalSizeContainer.innerHTML = '';
                    if (currentVariants.length > 0) {
                        currentVariants.forEach((v, idx) => {
                            const label = document.createElement('label');
                            label.className = 'btn-cafe-option flex-fill text-center';
                            label.innerHTML = `
                                <input type="radio" name="variantId" value="${v.variantId}" data-price="${v.price}" ${idx === 0 ? 'checked' : ''} required />
                                <div>
                                    <div class="fw-bold">Size ${v.sizeName}</div>
                                    <div class="small opacity-75">${v.price.toLocaleString('vi-VN')} đ</div>
                                </div>
                            `;
                            modalSizeContainer.appendChild(label);
                        });

                        currentSelectedPrice = currentVariants[0].price;
                    } else {
                        currentSelectedPrice = 0;
                    }

                    // Attach listener to radio size
                    modalSizeContainer.querySelectorAll('input[name="variantId"]').forEach(r => {
                        r.addEventListener('change', function () {
                            currentSelectedPrice = parseFloat(this.getAttribute('data-price')) || 0;
                            updatePriceDisplay();
                        });
                    });

                    updatePriceDisplay();
                    customModal.show();
                });
            });

            // Quantity stepper buttons
            document.getElementById('btnMinusQty').addEventListener('click', function () {
                let q = parseInt(inputQty.value) || 1;
                if (q > 1) {
                    inputQty.value = q - 1;
                    updatePriceDisplay();
                }
            });

            document.getElementById('btnPlusQty').addEventListener('click', function () {
                let q = parseInt(inputQty.value) || 1;
                if (q < 50) {
                    inputQty.value = q + 1;
                    updatePriceDisplay();
                }
            });
        });
    </script>
}
