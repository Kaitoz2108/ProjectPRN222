@model List<CafeManagementSystem.Models.Entities.Product>
@{
    ViewData["Title"] = "Thực Đơn Đồ Uống";
    var categories = ViewBag.Categories as List<CafeManagementSystem.Models.Entities.Category> ?? new();
    int? selectedCat = ViewBag.SelectedCategoryId as int?;
}

<div class="container py-4">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-dark"><i class="bi bi-cup-hot text-danger me-2"></i>Thực Đơn Đồ Uống CMS Café</h2>
        <p class="text-muted">Đồ uống chất lượng từ hạt Robusta & Arabica nguyên chất, trà hoa quả tươi mát</p>
    </div>

    <!-- Danh mục -->
    <div class="d-flex justify-content-center gap-2 mb-4 flex-wrap">
        <a asp-action="Menu" class="btn @(selectedCat == null ? "btn-danger" : "btn-outline-danger") rounded-pill px-3">
            Tất cả danh mục
        </a>
        @foreach (var cat in categories)
        {
            <a asp-action="Menu" asp-route-categoryId="@cat.CategoryId"
               class="btn @(selectedCat == cat.CategoryId ? "btn-danger" : "btn-outline-danger") rounded-pill px-3">
                @cat.CategoryName
            </a>
        }
    </div>

    <!-- Danh sách sản phẩm -->
    <div class="row g-4">
        @foreach (var prod in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                    <div class="bg-light text-center py-4 text-secondary position-relative" style="height: 180px;">
                        <i class="bi bi-cup-straw" style="font-size: 5rem; opacity: 0.3;"></i>
                        <span class="badge bg-danger position-absolute top-0 end-0 m-2">@prod.Category.CategoryName</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="fw-bold card-title mb-1">@prod.ProductName</h5>
                        <p class="card-text text-muted small flex-grow-1">@(prod.Description ?? "Hương vị thơm ngon, tự nhiên.")</p>
                        <div class="border-top pt-3 mt-2">
                            <div class="small fw-semibold text-secondary mb-1">Kích cỡ & Giá bán:</div>
                            <div class="d-flex gap-2 flex-wrap">
                                @foreach (var v in prod.ProductVariants.OrderBy(v => v.Price))
                                {
                                    <span class="badge bg-light text-dark border">
                                        Size @v.SizeName: <strong>@v.Price.ToString("N0") đ</strong>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
