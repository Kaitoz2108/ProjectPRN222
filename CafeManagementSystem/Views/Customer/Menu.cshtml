@model List<CafeManagementSystem.Models.Entities.Product>
@{
    ViewData["Title"] = "Thực Đơn Đồ Uống";
    var categories = ViewBag.Categories as List<CafeManagementSystem.Models.Entities.Category> ?? new();
    int? selectedCat = ViewBag.SelectedCategoryId as int?;
    int cartCount = ViewBag.CartCount as int? ?? 0;
}

<div class="container py-4">
    <!-- Header banner & Cart shortcut -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-cup-hot text-danger me-2"></i>Thực Đơn Đồ Uống CMS Café</h2>
            <p class="text-muted mb-0">Hương vị nguyên bản, pha chế trực tiếp từ quầy bar</p>
        </div>
        <a asp-action="Cart" class="btn btn-warning rounded-pill px-4 py-2 fw-bold shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-cart3 fs-5"></i>
            <span>Giỏ hàng Online</span>
            <span class="badge bg-danger rounded-pill">@cartCount</span>
        </a>
    </div>

    <!-- Danh mục lọc -->
    <div class="d-flex justify-content-start gap-2 mb-4 flex-wrap">
        <a asp-action="Menu" class="btn @(selectedCat == null ? "btn-danger" : "btn-outline-danger") rounded-pill px-3">
            Tất cả danh mục
        </a>
        @foreach (var cat in categories)
        {
            <a asp-action="Menu" asp-route-categoryId="@cat.CategoryId"
               class="btn @(selectedCat == cat.CategoryId ? "btn-danger" : "btn-outline-danger") rounded-pill px-3">
                @cat.CategoryName
            </a>
        }
    </div>

    <!-- Danh sách sản phẩm -->
    <div class="row g-4">
        @foreach (var prod in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                    <div class="bg-light text-center py-4 text-secondary position-relative" style="height: 160px;">
                        <i class="bi bi-cup-straw text-warning" style="font-size: 5rem; opacity: 0.4;"></i>
                        <span class="badge bg-danger position-absolute top-0 end-0 m-2">@prod.Category.CategoryName</span>
                    </div>
                    <div class="card-body d-flex flex-column p-3">
                        <h5 class="fw-bold card-title mb-1">@prod.ProductName</h5>
                        <p class="card-text text-muted small flex-grow-1">@(prod.Description ?? "Thức uống chất lượng cao được tuyển chọn kỹ lưỡng.")</p>

                        <div class="border-top pt-3 mt-2">
                            <form asp-controller="Customer" asp-action="AddToCart" method="post">
                                @Html.AntiForgeryToken()
                                <div class="mb-2">
                                    <label class="form-label small fw-bold text-secondary mb-1">Chọn Size & Giá:</label>
                                    <select name="variantId" class="form-select form-select-sm" required>
                                        @foreach (var v in prod.ProductVariants.OrderBy(v => v.Price))
                                        {
                                            <option value="@v.VariantId">
                                                Size @v.SizeName - @v.Price.ToString("N0") đ
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-0">Đường</label>
                                        <select name="sugarLevel" class="form-select form-select-sm">
                                            <option value="100%">100% đường</option>
                                            <option value="70%">70% đường</option>
                                            <option value="50%">50% đường</option>
                                            <option value="0%">Không đường</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-0">Đá</label>
                                        <select name="iceLevel" class="form-select form-select-sm">
                                            <option value="100%">100% đá</option>
                                            <option value="70%">70% đá</option>
                                            <option value="50%">50% đá</option>
                                            <option value="0%">Không đá</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="d-flex gap-2">
                                    <input type="number" name="quantity" value="1" min="1" max="50" class="form-control form-control-sm text-center" style="width: 70px;" />
                                    <button type="submit" class="btn btn-danger btn-sm flex-grow-1 fw-bold">
                                        <i class="bi bi-cart-plus me-1"></i>Thêm vào giỏ
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
