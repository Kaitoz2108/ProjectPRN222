@model CafeManagementSystem.Models.ViewModels.CustomerCheckoutViewModel
@{
    ViewData["Title"] = "Giỏ Hàng & Đặt Món Trực Tuyến";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-dark mb-1">Giỏ hàng của bạn</h2>
            <p class="text-muted small mb-0">Kiểm tra lại thức uống và nhập địa chỉ giao hàng tận nơi</p>
        </div>
        <a asp-action="Menu" class="btn btn-cafe-outline rounded-pill btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Tiếp tục chọn món
        </a>
    </div>

    @if (!Model.CartItems.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5" 
             style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
            <div class="card-body py-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                     style="width: 80px; height: 80px; background-color: #F0ECE4; color: var(--text-muted);">
                    <i class="bi bi-cart-x fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark">Giỏ hàng của bạn đang trống</h4>
                <p class="text-muted small mb-4">Hãy khám phá thực đơn cà phê rang mộc & trà thảo mộc tươi mát nhé!</p>
                <a asp-action="Menu" class="btn btn-cafe-primary rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-cup-straw me-1"></i> Khám phá thực đơn ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cột trái: Danh sách món trong giỏ -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3" 
                     style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                    
                    <div class="card-header border-bottom p-3 d-flex justify-content-between align-items-center" 
                         style="background-color: #FAF7F2; border-color: var(--border-color) !important;">
                        <span class="fw-bold text-dark fs-6">
                            <i class="bi bi-receipt me-1" style="color: var(--primary-green);"></i>
                            Món đã chọn (@Model.CartItems.Sum(c => c.Quantity))
                        </span>
                        <form asp-action="ClearCart" method="post" onsubmit="return confirm('Bạn có chắc muốn làm trống giỏ hàng?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link text-danger p-0 small text-decoration-none fw-semibold">
                                <i class="bi bi-trash3 me-1"></i>Xóa tất cả
                            </button>
                        </form>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0" style="font-size: 0.92rem;">
                                <thead style="background-color: #F8F5EE;">
                                    <tr class="text-muted small">
                                        <th class="ps-3 py-3">Đồ uống</th>
                                        <th class="text-center py-3">Số lượng</th>
                                        <th class="text-end py-3">Đơn giá</th>
                                        <th class="text-end py-3">Thành tiền</th>
                                        <th class="pe-3 py-3" style="width: 40px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.CartItems.Count; i++)
                                    {
                                        var item = Model.CartItems[i];
                                        <tr style="border-bottom: 1px solid var(--border-light);">
                                            <td class="ps-3 py-3">
                                                <div class="d-flex align-items-center gap-2">
                                                    <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/products/default.jpg" : item.ImageUrl)" 
                                                         alt="" class="cafe-thumb-sm" 
                                                         onerror="this.onerror=null; this.src='/images/products/default.jpg';" />
                                                    <div>
                                                        <div class="fw-bold text-dark">
                                                            @item.ProductName 
                                                            <span class="badge rounded-pill bg-light text-dark border ms-1">Size @item.SizeName</span>
                                                        </div>
                                                        <div class="small text-muted" style="font-size: 0.78rem;">
                                                            Đường: @item.SugarLevel • Đá: @item.IceLevel
                                                            @if (!string.IsNullOrWhiteSpace(item.ItemNote))
                                                            {
                                                                <span class="fst-italic" style="color: var(--accent-caramel);">(@item.ItemNote)</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center py-3">
                                                <span class="badge rounded-pill px-3 py-2 fw-bold" style="background-color: #F0ECE4; color: var(--text-main);">
                                                    @item.Quantity
                                                </span>
                                            </td>
                                            <td class="text-end text-muted small py-3">@item.UnitPrice.ToString("N0") đ</td>
                                            <td class="text-end fw-bold py-3" style="color: var(--primary-green);">@item.LineTotal.ToString("N0") đ</td>
                                            <td class="text-center pe-3 py-3">
                                                <form asp-action="RemoveFromCart" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="index" value="@i" />
                                                    <button type="submit" class="btn btn-link text-danger p-0" title="Xóa món">
                                                        <i class="bi bi-x-circle-fill"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="p-3 border-top" style="border-color: var(--border-color) !important; background-color: #FAF7F2;">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Tiền đồ uống:</span>
                            <span class="fw-bold text-dark">@Model.SubTotal.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Phí giao hàng:</span>
                            <span class="fw-bold text-dark">@Model.ShippingFee.ToString("N0") đ</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Thông tin giao hàng & Thanh toán -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden" 
                     style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                    
                    <div class="card-header border-bottom p-3" style="background-color: var(--sidebar-bg); border-color: var(--border-color) !important;">
                        <h5 class="fw-bold text-white mb-0">
                            <i class="bi bi-truck me-2" style="color: #FFE082;"></i>Thông Tin Nhận Hàng & Thanh Toán
                        </h5>
                    </div>

                    <div class="card-body p-4">
                        <form asp-action="Checkout" method="post" id="checkoutForm">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="RecipientName" class="form-label small fw-bold text-dark"></label> <span class="text-danger">*</span>
                                <input asp-for="RecipientName" class="form-control" required />
                                <span asp-validation-for="RecipientName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="RecipientPhone" class="form-label small fw-bold text-dark"></label> <span class="text-danger">*</span>
                                <input asp-for="RecipientPhone" class="form-control" required />
                                <span asp-validation-for="RecipientPhone" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ShippingAddress" class="form-label small fw-bold text-dark"></label> <span class="text-danger">*</span>
                                <textarea asp-for="ShippingAddress" class="form-control" rows="2" required placeholder="Số nhà, tên đường, phường, quận..."></textarea>
                                <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="OrderNote" class="form-label small fw-bold text-dark"></label>
                                <input asp-for="OrderNote" class="form-control" placeholder="Ghi chú giao hàng (gọi trước khi đến...)" />
                            </div>

                            <!-- Điểm tích lũy thành viên -->
                            <div class="p-3 rounded-3 mb-3" style="background-color: #FFF9F0; border: 1px solid #FFE0B2;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small fw-bold text-dark">
                                        <i class="bi bi-stars" style="color: var(--accent-caramel);"></i> Điểm tích lũy hiện có:
                                    </span>
                                    <span class="badge rounded-pill fw-bold" style="background-color: #FFE0B2; color: #B76E00;">
                                        @Model.AvailableLoyaltyPoints điểm
                                    </span>
                                </div>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white">Dùng:</span>
                                    <input asp-for="PointsUsed" type="number" min="0" max="@Model.AvailableLoyaltyPoints" class="form-control text-end fw-bold" id="pointsInput" />
                                    <span class="input-group-text bg-white">điểm (= <span id="discountPreview" class="text-success fw-bold ms-1">0</span> đ)</span>
                                </div>
                                <small class="text-muted mt-1 d-block" style="font-size: 0.78rem;">
                                    1 điểm = 1.000đ giảm giá trực tiếp vào tổng tiền thanh toán.
                                </small>
                            </div>

                            <!-- Phương thức thanh toán -->
                            <div class="mb-4">
                                <label class="form-label small fw-bold text-dark mb-2">Phương thức thanh toán:</label>
                                <div class="d-flex flex-column gap-2">
                                    <label class="btn-cafe-option">
                                        <input type="radio" asp-for="PaymentMethod" value="COD" id="payCod" checked>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="d-flex align-items-center gap-2">
                                                <i class="bi bi-cash-stack text-success fs-5"></i>
                                                <span>Tiền mặt khi nhận hàng (COD)</span>
                                            </span>
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                        </div>
                                    </label>

                                    <label class="btn-cafe-option">
                                        <input type="radio" asp-for="PaymentMethod" value="Transfer" id="payTransfer">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="d-flex align-items-center gap-2">
                                                <i class="bi bi-qr-code text-primary fs-5"></i>
                                                <span>Chuyển khoản QR (VietQR 24/7)</span>
                                            </span>
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- Tổng kết chi phí -->
                            <div class="border-top pt-3 mb-3" style="border-color: var(--border-color) !important;">
                                <div class="d-flex justify-content-between mb-1 small text-muted">
                                    <span>Tiền nước:</span>
                                    <span>@Model.SubTotal.ToString("N0") đ</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1 small text-muted">
                                    <span>Phí giao hàng:</span>
                                    <span>@Model.ShippingFee.ToString("N0") đ</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 small text-success fw-bold">
                                    <span>Giảm giá điểm:</span>
                                    <span id="discountRow">-0 đ</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center border-top pt-2" style="border-color: var(--border-color) !important;">
                                    <span class="fw-bold fs-6 text-dark">TỔNG CỘNG:</span>
                                    <span class="fw-bold fs-4" style="color: var(--primary-green);" id="totalPreview">
                                        @Model.TotalAmount.ToString("N0") đ
                                    </span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-cafe-primary btn-lg w-100 rounded-pill fw-bold shadow-sm py-3">
                                <i class="bi bi-bag-check-fill me-2"></i> Xác Nhận Đặt Hàng
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const subTotal = @Model.SubTotal;
        const shippingFee = @Model.ShippingFee;
        const maxPoints = @Model.AvailableLoyaltyPoints;
        const pointsInput = document.getElementById('pointsInput');
        const discountPreview = document.getElementById('discountPreview');
        const discountRow = document.getElementById('discountRow');
        const totalPreview = document.getElementById('totalPreview');

        if (pointsInput) {
            pointsInput.addEventListener('input', function () {
                let pts = parseInt(this.value) || 0;
                if (pts < 0) pts = 0;
                const maxUsable = Math.min(maxPoints, Math.floor(subTotal / 1000));
                if (pts > maxUsable) pts = maxUsable;
                this.value = pts;

                const discount = pts * 1000;
                const total = Math.max(0, subTotal - discount + shippingFee);

                discountPreview.innerText = discount.toLocaleString('vi-VN');
                discountRow.innerText = '-' + discount.toLocaleString('vi-VN') + ' đ';
                totalPreview.innerText = total.toLocaleString('vi-VN') + ' đ';
            });
        }
    </script>
}
