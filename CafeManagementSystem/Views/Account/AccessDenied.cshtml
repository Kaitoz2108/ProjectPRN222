@{
    ViewData["Title"] = "Từ Chối Quyền Truy Cập";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-5" 
             style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
            <div class="mb-3" style="color: var(--status-danger);">
                <i class="bi bi-shield-x fs-1" style="font-size: 3.5rem !important;"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Từ Chối Quyền Truy Cập</h3>
            <p class="text-muted mb-4 small" style="max-width: 420px; margin: 0 auto;">
                Tài khoản của bạn hiện không có quyền truy cập vào phân hệ này. Vui lòng liên hệ Quản trị viên (Admin) nếu cần cấp thêm quyền hạn.
            </p>
            <div>
                <a asp-controller="Account" asp-action="Login" class="btn btn-cafe-primary rounded-pill px-4 fw-bold">
                    <i class="bi bi-arrow-left me-1"></i> Quay Lại Đăng Nhập
                </a>
            </div>
        </div>
    </div>
</div>
