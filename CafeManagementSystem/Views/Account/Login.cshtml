@model CafeManagementSystem.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Hệ Thống CMS";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white text-center py-3 rounded-top-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-cup-hot-fill me-2"></i>Café Management System</h4>
                <small class="text-white-50">Đăng nhập tài khoản làm việc hoặc khách hàng</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input asp-for="Phone" class="form-control" id="phoneInput" placeholder="VD: 0901000002" autofocus />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control" id="passwordInput" placeholder="Nhập mật khẩu" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                        </button>
                    </div>

                    <div class="text-center">
                        <span class="text-muted">Chưa có tài khoản khách hàng?</span>
                        <a asp-action="Register" class="fw-semibold text-decoration-none">Đăng ký ngay</a>
                    </div>
                </form>

                <hr class="my-4" />

                <!-- Hộp Chọn Nhanh Tài Khoản Demo 5 Role -->
                <div class="bg-light p-3 rounded-3 border">
                    <h6 class="fw-bold text-secondary mb-2 text-center">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Chọn nhanh tài khoản Demo (5 Role)
                    </h6>
                    <p class="text-muted small text-center mb-3">Bấm vào nút để tự động điền SĐT & Mật khẩu chung (<code>123456</code>):</p>
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-sm btn-outline-danger text-start d-flex justify-content-between align-items-center" onclick="fillDemo('0901000001', '123456')">
                            <span><span class="badge bg-danger me-2">Admin</span> Nguyễn Quản Trị</span>
                            <small class="text-muted">0901000001</small>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary text-start d-flex justify-content-between align-items-center" onclick="fillDemo('0901000002', '123456')">
                            <span><span class="badge bg-primary me-2">Cashier</span> Trần Thu Ngân</span>
                            <small class="text-muted">0901000002</small>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning text-dark text-start d-flex justify-content-between align-items-center" onclick="fillDemo('0901000003', '123456')">
                            <span><span class="badge bg-warning text-dark me-2">Barista</span> Lê Pha Chế</span>
                            <small class="text-muted">0901000003</small>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-info text-dark text-start d-flex justify-content-between align-items-center" onclick="fillDemo('0901000004', '123456')">
                            <span><span class="badge bg-info text-dark me-2">DeliveryStaff</span> Phạm Giao Hàng</span>
                            <small class="text-muted">0901000004</small>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-success text-start d-flex justify-content-between align-items-center" onclick="fillDemo('0988888888', '123456')">
                            <span><span class="badge bg-success me-2">Customer</span> Đặng Minh Hiếu (150đ)</span>
                            <small class="text-muted">0988888888</small>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillDemo(phone, pass) {
            document.getElementById('phoneInput').value = phone;
            document.getElementById('passwordInput').value = pass;
        }
    </script>
}
