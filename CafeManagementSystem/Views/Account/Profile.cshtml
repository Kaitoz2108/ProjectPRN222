@model CafeManagementSystem.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân";
}

<div class="container py-4">
    <div class="row g-4">
        <!-- Thông tin tổng quan -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4" 
                 style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle text-white shadow-sm" 
                     style="width: 84px; height: 84px; font-size: 32px; background-color: var(--primary-green);">
                    <i class="bi bi-person"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">@Model.FullName</h5>
                <p class="text-muted small mb-2">@Model.Phone</p>

                <div class="mb-3">
                    @if (Model.RoleName == "Admin")
                    {
                        <span class="badge rounded-pill bg-danger px-3 py-2"><i class="bi bi-shield-lock me-1"></i> Quản Trị Viên (Admin)</span>
                    }
                    else if (Model.RoleName == "Cashier")
                    {
                        <span class="badge rounded-pill px-3 py-2 text-white" style="background-color: var(--primary-green);"><i class="bi bi-calculator me-1"></i> Thu Ngân (Cashier)</span>
                    }
                    else if (Model.RoleName == "Barista")
                    {
                        <span class="badge rounded-pill px-3 py-2 text-white" style="background-color: var(--accent-caramel);"><i class="bi bi-cup-hot me-1"></i> Pha Chế (Barista)</span>
                    }
                    else if (Model.RoleName == "DeliveryStaff")
                    {
                        <span class="badge rounded-pill bg-info text-dark px-3 py-2"><i class="bi bi-bicycle me-1"></i> Giao Hàng (Shipper)</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-success px-3 py-2"><i class="bi bi-person-heart me-1"></i> Khách Hàng (Customer)</span>
                    }
                </div>

                @if (Model.RoleName == "Customer")
                {
                    <div class="p-3 mt-2 rounded-3 text-start" style="background-color: #FFF9F0; border: 1px solid #FFE0B2;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted fw-bold d-block" style="font-size: 0.72rem;">ĐIỂM TÍCH LŨY HIỆN CÓ</small>
                                <span class="fs-4 fw-bold text-dark">@Model.LoyaltyPoints.ToString("N0") <small class="fs-6 text-muted">điểm</small></span>
                            </div>
                            <i class="bi bi-stars fs-2" style="color: var(--accent-caramel);"></i>
                        </div>
                        <small class="text-muted mt-2 d-block" style="font-size: 0.78rem;">
                            <i class="bi bi-info-circle me-1"></i> 1 điểm = 1.000đ khi thanh toán đơn tại quầy hoặc đặt online.
                        </small>
                    </div>
                }

                <div class="text-muted small mt-4 pt-3 border-top text-start" style="border-color: var(--border-color) !important; font-size: 0.8rem;">
                    <div class="mb-1"><i class="bi bi-calendar3 me-2"></i>Tham gia: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    <div><i class="bi bi-shield-check me-2 text-success"></i>Tài khoản đang hoạt động</div>
                </div>
            </div>
        </div>

        <!-- Cập nhật thông tin chi tiết -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" 
                 style="background-color: var(--surface-card); border: 1px solid var(--border-color) !important;">
                <div class="card-header border-bottom p-3" style="background-color: #FAF7F2; border-color: var(--border-color) !important;">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-pencil-square me-2" style="color: var(--primary-green);"></i>Cập Nhật Thông Tin Cá Nhân</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 rounded-3 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label small fw-bold text-dark"></label> <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control border-start-0" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label small fw-bold text-dark"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Phone" class="form-control border-start-0 bg-light" readonly />
                                </div>
                                <small class="text-muted" style="font-size: 0.75rem;">Số điện thoại là mã định danh, không thể thay đổi.</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label small fw-bold text-dark"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control border-start-0" placeholder="example@mail.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label small fw-bold text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="Address" class="form-control border-start-0" placeholder="Địa chỉ giao hàng mặc định" />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-cafe-primary rounded-pill px-4 fw-bold">
                                <i class="bi bi-check2 me-1"></i> Lưu Thay Đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
